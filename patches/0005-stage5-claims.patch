@@ -0,0 +1,347 @@
+// Copyright (c) 2026 Sento Daimon
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+// Coin Series claim RPCs: look up snapshot outputs, build claim transactions,
+// attach ownership proofs (from a wallet signature or by signing with keys).
+
+#include <base58.h>
+#include <chainparams.h>
+#include <coins.h>
+#include <coinseries_claim.h>
+#include <coinseries_snapshot.h>
+#include <core_io.h>
+#include <key.h>
+#include <key_io.h>
+#include <kernel/coinseries.h>
+#include <node/context.h>
+#include <rpc/server.h>
+#include <rpc/server_util.h>
+#include <rpc/util.h>
+#include <script/descriptor.h>
+#include <script/signingprovider.h>
+#include <script/solver.h>
+#include <univalue.h>
+#include <util/strencodings.h>
+#include <validation.h>
+
+#include <set>
+
+using node::NodeContext;
+
+namespace {
+void RequireClaims()
+{
+    if (!g_coin_series_chain) throw JSONRPCError(RPC_METHOD_NOT_FOUND, "only available on Coin Series chains");
+    if (!g_claim_snapshot) throw JSONRPCError(RPC_MISC_ERROR, "the claim snapshot is not loaded on this node");
+}
+
+CMutableTransaction DecodeClaimTx(const UniValue& v)
+{
+    CMutableTransaction mtx;
+    if (!DecodeHexTx(mtx, v.get_str(), /*try_no_witness=*/false, /*try_witness=*/true)) {
+        throw JSONRPCError(RPC_DESERIALIZATION_ERROR, "TX decode failed");
+    }
+    if (mtx.version != COIN_SERIES_CLAIM_TX_VERSION) throw JSONRPCError(RPC_INVALID_PARAMETER, "not a claim transaction");
+    return mtx;
+}
+
+Coin SnapshotCoin(const COutPoint& op)
+{
+    auto coin = g_claim_snapshot->Lookup(op);
+    if (!coin) throw JSONRPCError(RPC_INVALID_ADDRESS_OR_KEY, strprintf("%s:%u is not in the claim snapshot", op.hash.GetHex(), op.n));
+    return *coin;
+}
+
+UniValue CoinToJSON(const COutPoint& op, const Coin& coin)
+{
+    UniValue o(UniValue::VOBJ);
+    o.pushKV("txid", op.hash.GetHex());
+    o.pushKV("vout", op.n);
+    o.pushKV("bitcoin_amount", ValueFromAmount(coin.out.nValue));
+    o.pushKV("claim_amount", ValueFromAmount(coin.out.nValue * g_claim_snapshot->Multiplier()));
+    o.pushKV("scriptPubKey", HexStr(coin.out.scriptPubKey));
+    std::vector<std::vector<unsigned char>> sol;
+    o.pushKV("type", GetTxnOutputType(Solver(coin.out.scriptPubKey, sol)));
+    return o;
+}
+
+/** Decode a Bitcoin private key in WIF (mainnet 0x80 or testnet/regtest 0xEF prefix). */
+CKey DecodeBitcoinWif(const std::string& wif)
+{
+    std::vector<unsigned char> data;
+    CKey key;
+    if (!DecodeBase58Check(wif, data, 34) || (data.size() != 33 && data.size() != 34) || (data[0] != 0x80 && data[0] != 0xEF)) {
+        throw JSONRPCError(RPC_INVALID_ADDRESS_OR_KEY, "invalid Bitcoin private key (WIF)");
+    }
+    const bool compressed = data.size() == 34 && data[33] == 1;
+    key.Set(data.begin() + 1, data.begin() + 33, compressed);
+    if (!key.IsValid()) throw JSONRPCError(RPC_INVALID_ADDRESS_OR_KEY, "invalid Bitcoin private key");
+    return key;
+}
+
+FlatSigningProvider ProviderForKeys(const std::vector<CKey>& keys)
+{
+    FlatSigningProvider provider;
+    for (const CKey& key : keys) {
+        const std::string wif = EncodeSecret(key); // this chain's encoding, only to build descriptors
+        std::vector<std::string> descs{"combo(" + wif + ")"};
+        if (key.IsCompressed()) descs.push_back("tr(" + wif + ")");
+        for (const auto& d : descs) {
+            FlatSigningProvider keyp;
+            std::string error;
+            auto parsed = Parse(d, keyp, error, /*require_checksum=*/false);
+            if (parsed.size() != 1) throw JSONRPCError(RPC_INTERNAL_ERROR, error);
+            std::vector<CScript> scripts;
+            FlatSigningProvider out;
+            parsed[0]->Expand(0, keyp, scripts, out);
+            provider.Merge(std::move(keyp));
+            provider.Merge(std::move(out));
+        }
+    }
+    return provider;
+}
+} // namespace
+
+static RPCHelpMan getsnapshotinfo()
+{
+    return RPCHelpMan{"getsnapshotinfo",
+        "Coin Series: information about the claim snapshot (the Bitcoin UTXO set at the snapshot height).",
+        {},
+        RPCResult{RPCResult::Type::OBJ, "", "", {
+            {RPCResult::Type::BOOL, "loaded", "whether the snapshot is loaded"},
+            {RPCResult::Type::STR, "path", /*optional=*/true, "snapshot file"},
+            {RPCResult::Type::STR_HEX, "base_blockhash", /*optional=*/true, "Bitcoin block of the snapshot"},
+            {RPCResult::Type::NUM, "outputs", /*optional=*/true, "number of outputs"},
+            {RPCResult::Type::STR_AMOUNT, "bitcoin_total", /*optional=*/true, "total amount in Bitcoin units"},
+            {RPCResult::Type::STR_AMOUNT, "claimable_total", /*optional=*/true, "nominal claimable amount on this chain (x multiplier)"},
+            {RPCResult::Type::STR_HEX, "hash_serialized", /*optional=*/true, "verified UTXO set hash"},
+        }},
+        RPCExamples{HelpExampleCli("getsnapshotinfo", "")},
+        [&](const RPCHelpMan& self, const JSONRPCRequest& request) -> UniValue
+{
+    UniValue r(UniValue::VOBJ);
+    r.pushKV("loaded", g_claim_snapshot != nullptr);
+    if (g_claim_snapshot) {
+        const auto& info = g_claim_snapshot->GetInfo();
+        r.pushKV("path", fs::PathToString(g_claim_snapshot->Path()));
+        r.pushKV("base_blockhash", info.base_blockhash.GetHex());
+        r.pushKV("outputs", info.coins_count);
+        r.pushKV("bitcoin_total", ValueFromAmount(info.total_amount));
+        r.pushKV("claimable_total", ValueFromAmount(info.total_amount * g_claim_snapshot->Multiplier()));
+        r.pushKV("hash_serialized", info.hash_serialized.GetHex());
+    }
+    return r;
+},
+    };
+}
+
+static RPCHelpMan getclaimable()
+{
+    return RPCHelpMan{"getclaimable",
+        "Coin Series: look up a Bitcoin output in the claim snapshot and whether it is already claimed on this chain.",
+        {
+            {"txid", RPCArg::Type::STR_HEX, RPCArg::Optional::NO, "Bitcoin transaction id"},
+            {"vout", RPCArg::Type::NUM, RPCArg::Optional::NO, "output index"},
+        },
+        RPCResult{RPCResult::Type::OBJ, "", "", {
+            {RPCResult::Type::BOOL, "found", "whether the output is in the snapshot"},
+            {RPCResult::Type::BOOL, "claimed", /*optional=*/true, "already claimed on this chain (including the mempool)"},
+            {RPCResult::Type::ELISION, "", "snapshot output details"},
+        }},
+        RPCExamples{HelpExampleCli("getclaimable", "\"txid\" 0")},
+        [&](const RPCHelpMan& self, const JSONRPCRequest& request) -> UniValue
+{
+    RequireClaims();
+    const COutPoint op{Txid::FromUint256(ParseHashV(request.params[0], "txid")), static_cast<uint32_t>(request.params[1].getInt<int>())};
+    UniValue r(UniValue::VOBJ);
+    auto coin = g_claim_snapshot->Lookup(op);
+    r.pushKV("found", coin.has_value());
+    if (!coin) return r;
+    NodeContext& node = EnsureAnyNodeContext(request.context);
+    ChainstateManager& chainman = EnsureChainman(node);
+    const CTxMemPool& mempool = EnsureMemPool(node);
+    bool claimed;
+    {
+        LOCK2(cs_main, mempool.cs);
+        const Coin& view_coin = chainman.ActiveChainstate().CoinsTip().AccessCoin(op);
+        claimed = view_coin.IsSpent() || view_coin.nHeight != COIN_SERIES_CLAIM_COIN_HEIGHT || mempool.isSpent(op);
+    }
+    r.pushKV("claimed", claimed);
+    const UniValue details = CoinToJSON(op, *coin);
+    for (size_t i = 0; i < details.size(); ++i) r.pushKV(details.getKeys()[i], details[i]);
+    return r;
+},
+    };
+}
+
+static RPCHelpMan createclaim()
+{
+    return RPCHelpMan{"createclaim",
+        "Coin Series: create an unsigned claim transaction and the message each owner must sign.\n"
+        "The difference between the claimed amount and the outputs is the fee.",
+        {
+            {"inputs", RPCArg::Type::ARR, RPCArg::Optional::NO, "Bitcoin outputs to claim",
+                {{"", RPCArg::Type::OBJ, RPCArg::Optional::OMITTED, "", {
+                    {"txid", RPCArg::Type::STR_HEX, RPCArg::Optional::NO, "Bitcoin transaction id"},
+                    {"vout", RPCArg::Type::NUM, RPCArg::Optional::NO, "output index"},
+                }}}},
+            {"outputs", RPCArg::Type::ARR, RPCArg::Optional::NO, "receiving addresses on this chain",
+                {{"", RPCArg::Type::OBJ_USER_KEYS, RPCArg::Optional::OMITTED, "", {
+                    {"address", RPCArg::Type::AMOUNT, RPCArg::Optional::NO, "amount"},
+                }}}},
+        },
+        RPCResult{RPCResult::Type::OBJ, "", "", {
+            {RPCResult::Type::STR_HEX, "hex", "unsigned claim transaction"},
+            {RPCResult::Type::STR, "message", "message to sign for every input (BIP-322 or legacy signed message)"},
+            {RPCResult::Type::STR_AMOUNT, "fee", "claimed amount minus outputs"},
+            {RPCResult::Type::ARR, "inputs", "", {{RPCResult::Type::ELISION, "", "snapshot output details"}}},
+        }},
+        RPCExamples{HelpExampleCli("createclaim", "'[{\"txid\":\"...\",\"vout\":0}]' '[{\"hf1...\":0.5}]'")},
+        [&](const RPCHelpMan& self, const JSONRPCRequest& request) -> UniValue
+{
+    RequireClaims();
+    CMutableTransaction mtx;
+    mtx.version = COIN_SERIES_CLAIM_TX_VERSION;
+    mtx.nLockTime = 0;
+    UniValue details(UniValue::VARR);
+    CAmount total_in = 0;
+    std::set<COutPoint> seen;
+    for (const UniValue& in : request.params[0].get_array().getValues()) {
+        const COutPoint op{Txid::FromUint256(ParseHashO(in, "txid")), static_cast<uint32_t>(in.find_value("vout").getInt<int>())};
+        if (!seen.insert(op).second) throw JSONRPCError(RPC_INVALID_PARAMETER, "duplicate input");
+        const Coin coin = SnapshotCoin(op);
+        mtx.vin.emplace_back(op, CScript{}, uint32_t{CTxIn::SEQUENCE_FINAL});
+        total_in += coin.out.nValue * g_claim_snapshot->Multiplier();
+        details.push_back(CoinToJSON(op, coin));
+    }
+    if (mtx.vin.empty() || mtx.vin.size() > COIN_SERIES_MAX_CLAIM_INPUTS) throw JSONRPCError(RPC_INVALID_PARAMETER, "between 1 and 500 inputs");
+    CAmount total_out = 0;
+    for (const UniValue& out : request.params[1].get_array().getValues()) {
+        for (const std::string& addr : out.getKeys()) {
+            const CTxDestination dest = DecodeDestination(addr);
+            if (!IsValidDestination(dest)) throw JSONRPCError(RPC_INVALID_ADDRESS_OR_KEY, "invalid address for this chain: " + addr);
+            const CAmount amount = AmountFromValue(out.find_value(addr));
+            mtx.vout.emplace_back(amount, GetScriptForDestination(dest));
+            total_out += amount;
+        }
+    }
+    if (mtx.vout.empty()) throw JSONRPCError(RPC_INVALID_PARAMETER, "no outputs");
+    if (total_out > total_in) throw JSONRPCError(RPC_INVALID_PARAMETER, "outputs exceed the claimed amount");
+    UniValue r(UniValue::VOBJ);
+    r.pushKV("hex", EncodeHexTx(CTransaction(mtx)));
+    r.pushKV("message", ClaimMessage(CTransaction(mtx)));
+    r.pushKV("fee", ValueFromAmount(total_in - total_out));
+    r.pushKV("inputs", std::move(details));
+    return r;
+},
+    };
+}
+
+static RPCHelpMan getclaimmessage()
+{
+    return RPCHelpMan{"getclaimmessage",
+        "Coin Series: the message every owner signs for this claim transaction.",
+        {{"hex", RPCArg::Type::STR_HEX, RPCArg::Optional::NO, "claim transaction"}},
+        RPCResult{RPCResult::Type::STR, "", "message"},
+        RPCExamples{HelpExampleCli("getclaimmessage", "\"hex\"")},
+        [&](const RPCHelpMan& self, const JSONRPCRequest& request) -> UniValue
+{
+    RequireClaims();
+    return ClaimMessage(CTransaction(DecodeClaimTx(request.params[0])));
+},
+    };
+}
+
+static RPCHelpMan addclaimproof()
+{
+    return RPCHelpMan{"addclaimproof",
+        "Coin Series: attach an ownership proof made by a Bitcoin wallet.\n"
+        "The signature is over the claim message: a BIP-322 signature (prefix smp or ful), or a legacy\n"
+        "signed message (signmessage) for P2PKH outputs. It is checked before it is attached.",
+        {
+            {"hex", RPCArg::Type::STR_HEX, RPCArg::Optional::NO, "claim transaction"},
+            {"index", RPCArg::Type::NUM, RPCArg::Optional::NO, "input index"},
+            {"signature", RPCArg::Type::STR, RPCArg::Optional::NO, "signature string from the wallet"},
+        },
+        RPCResult{RPCResult::Type::STR_HEX, "", "claim transaction with the proof attached"},
+        RPCExamples{HelpExampleCli("addclaimproof", "\"hex\" 0 \"smpAkcw...\"")},
+        [&](const RPCHelpMan& self, const JSONRPCRequest& request) -> UniValue
+{
+    RequireClaims();
+    CMutableTransaction mtx = DecodeClaimTx(request.params[0]);
+    const int index = request.params[1].getInt<int>();
+    if (index < 0 || static_cast<size_t>(index) >= mtx.vin.size()) throw JSONRPCError(RPC_INVALID_PARAMETER, "input index out of range");
+    const Coin coin = SnapshotCoin(mtx.vin[index].prevout);
+    auto item = ParseClaimSignature(request.params[2].get_str(), coin.out.scriptPubKey);
+    if (!item) throw JSONRPCError(RPC_INVALID_PARAMETER, util::ErrorString(item).original);
+    mtx.vin[index].scriptWitness.stack = {*item};
+    std::string error;
+    if (!VerifyClaimProof(CTransaction(mtx), index, coin.out.scriptPubKey, error)) throw JSONRPCError(RPC_VERIFY_ERROR, "proof does not verify: " + error);
+    return EncodeHexTx(CTransaction(mtx));
+},
+    };
+}
+
+static RPCHelpMan signclaimwithkey()
+{
+    return RPCHelpMan{"signclaimwithkey",
+        "Coin Series: sign the ownership proofs of a claim transaction with Bitcoin private keys (WIF).\n"
+        "Use only on a computer you trust, ideally offline, and move the bitcoin to new keys first.",
+        {
+            {"hex", RPCArg::Type::STR_HEX, RPCArg::Optional::NO, "claim transaction"},
+            {"privkeys", RPCArg::Type::ARR, RPCArg::Optional::NO, "Bitcoin private keys in WIF",
+                {{"privkey", RPCArg::Type::STR_HEX, RPCArg::Optional::OMITTED, ""}}},
+        },
+        RPCResult{RPCResult::Type::OBJ, "", "", {
+            {RPCResult::Type::STR_HEX, "hex", "claim transaction with the proofs that could be made"},
+            {RPCResult::Type::BOOL, "complete", "whether every input has a valid proof"},
+            {RPCResult::Type::ARR, "errors", "inputs that could not be signed", {{RPCResult::Type::STR, "", ""}}},
+        }},
+        RPCExamples{HelpExampleCli("signclaimwithkey", "\"hex\" '[\"KxBitcoinWif...\"]'")},
+        [&](const RPCHelpMan& self, const JSONRPCRequest& request) -> UniValue
+{
+    RequireClaims();
+    CMutableTransaction mtx = DecodeClaimTx(request.params[0]);
+    std::vector<CKey> keys;
+    for (const UniValue& k : request.params[1].get_array().getValues()) keys.push_back(DecodeBitcoinWif(k.get_str()));
+    const FlatSigningProvider provider = ProviderForKeys(keys);
+    UniValue errors(UniValue::VARR);
+    bool complete = true;
+    for (size_t i = 0; i < mtx.vin.size(); ++i) {
+        const Coin coin = SnapshotCoin(mtx.vin[i].prevout);
+        std::string verify_error;
+        if (mtx.vin[i].scriptWitness.stack.size() == 1 && VerifyClaimProof(CTransaction(mtx), i, coin.out.scriptPubKey, verify_error)) continue;
+        auto item = SignClaimProof(CTransaction(mtx), coin.out.scriptPubKey, provider);
+        if (!item) {
+            complete = false;
+            errors.push_back(strprintf("input %u: %s", i, util::ErrorString(item).original));
+            continue;
+        }
+        mtx.vin[i].scriptWitness.stack = {*item};
+        if (!VerifyClaimProof(CTransaction(mtx), i, coin.out.scriptPubKey, verify_error)) {
+            complete = false;
+            errors.push_back(strprintf("input %u: %s", i, verify_error));
+        }
+    }
+    UniValue r(UniValue::VOBJ);
+    r.pushKV("hex", EncodeHexTx(CTransaction(mtx)));
+    r.pushKV("complete", complete);
+    r.pushKV("errors", std::move(errors));
+    return r;
+},
+    };
+}
+
+void RegisterCoinSeriesRPCCommands(CRPCTable& t)
+{
+    static const CRPCCommand commands[]{
+        {"coinseries", &getsnapshotinfo},
+        {"coinseries", &getclaimable},
+        {"coinseries", &createclaim},
+        {"coinseries", &getclaimmessage},
+        {"coinseries", &addclaimproof},
+        {"coinseries", &signclaimwithkey},
+    };
+    for (const auto& c : commands) t.appendCommand(c.name, &c);
+}
