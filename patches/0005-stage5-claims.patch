diff --git a/contrib/coinseries/claim_smoke.sh b/contrib/coinseries/claim_smoke.sh
new file mode 100755
index 0000000..17f1a8d
--- /dev/null
+++ b/contrib/coinseries/claim_smoke.sh
@@ -0,0 +1,141 @@
+#!/usr/bin/env bash
+# Coin Series claim end-to-end test (regtest).
+#  1. A Bitcoin regtest node (same binary, no -coin) pays outputs to keys we know:
+#     P2PKH, P2SH-P2WPKH, P2WPKH, P2TR, and a P2PKH owned by its wallet (for signmessage).
+#  2. dumptxoutset -> development claim snapshot with its serialized hash.
+#  3. Coin Series regtest nodes load the snapshot and claims are tested:
+#     sign with keys (BIP-322 simple/full), wallet signature (legacy signmessage), double claim,
+#     tampered outputs, proof reuse on another coin, normal tx spending a snapshot output,
+#     block disconnect / reconnect, restart.
+# Usage: contrib/coinseries/claim_smoke.sh <build/bin>
+set -uo pipefail
+BIN=${1:-build/bin}
+BTCDIR=$(mktemp -d); CSDIR=$(mktemp -d)
+FAIL=0
+pass() { echo "PASS  $*"; }
+fail() { echo "FAIL  $*"; FAIL=1; }
+btc() { "$BIN/bitcoin-cli" -datadir="$BTCDIR" -regtest "$@"; }
+cs() { local c=$1; shift; "$BIN/bitcoin-cli" -datadir="$CSDIR" -coin=$c -regtest "$@"; }
+cleanup() {
+  btc stop >/dev/null 2>&1; cs half stop >/dev/null 2>&1; cs quarter stop >/dev/null 2>&1
+  sleep 3; rm -rf "$BTCDIR" "$CSDIR"
+}
+trap cleanup EXIT
+J() { python3 -c "import sys,json;d=json.load(sys.stdin);print($1)"; }
+
+# ---- 1. Bitcoin regtest with known keys ----
+read -r -a WIFS < <(python3 - <<'EOF'
+import os, hashlib
+A='123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'
+def b58c(b):
+    b=b+hashlib.sha256(hashlib.sha256(b).digest()).digest()[:4]
+    n=int.from_bytes(b,'big'); s=''
+    while n: n,r=divmod(n,58); s=A[r]+s
+    return '1'*(len(b)-len(b.lstrip(b'\0')))+s
+N=0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141
+keys=[]
+while len(keys)<5:
+    k=os.urandom(32)
+    if 0<int.from_bytes(k,'big')<N: keys.append(b58c(b'\xef'+k+b'\x01'))
+print(' '.join(keys))
+EOF
+)
+"$BIN/bitcoind" -datadir="$BTCDIR" -regtest -daemon -listen=0 -fallbackfee=0.0001 >/dev/null
+btc -rpcwait createwallet miner >/dev/null
+MINER=$(btc -rpcwallet=miner getnewaddress)
+btc generatetoaddress 110 "$MINER" >/dev/null
+btc createwallet signer >/dev/null
+SIGNADDR=$(btc -rpcwallet=signer getnewaddress "" legacy)
+DESCS=("pkh(${WIFS[0]})" "sh(wpkh(${WIFS[1]}))" "wpkh(${WIFS[2]})" "tr(${WIFS[3]})" "pkh(${WIFS[4]})")
+NAMES=(p2pkh p2sh-p2wpkh p2wpkh p2tr spare-p2pkh)
+ADDRS=()
+for d in "${DESCS[@]}"; do
+  full=$(btc getdescriptorinfo "$d" | J "d['descriptor']")
+  ADDRS+=("$(btc deriveaddresses "$full" | J "d[0]")")
+done
+AMTS=(1 2 3 4 5)
+declare -A TXID VOUT
+locate() { # address txid -> sets TXID/VOUT
+  local v
+  v=$(btc -rpcwallet=miner gettransaction "$2" true true | python3 -c "
+import sys,json
+d=json.load(sys.stdin)
+print([o['n'] for o in d['decoded']['vout'] if o['scriptPubKey'].get('address')=='$1'][0])")
+  TXID[$1]=$2; VOUT[$1]=$v
+}
+for i in 0 1 2 3 4; do T=$(btc -rpcwallet=miner sendtoaddress "${ADDRS[$i]}" "${AMTS[$i]}"); locate "${ADDRS[$i]}" "$T"; done
+T=$(btc -rpcwallet=miner sendtoaddress "$SIGNADDR" 6); locate "$SIGNADDR" "$T"
+btc generatetoaddress 1 "$MINER" >/dev/null
+DUMP=$(btc dumptxoutset "$BTCDIR/snap.dat" latest)
+HASH=$(echo "$DUMP" | J "d['txoutset_hash']")
+echo "snapshot: $(echo "$DUMP" | J "d['coins_written']") outputs, hash $HASH"
+
+# ---- 2. Coin Series nodes with the snapshot ----
+for c in half quarter; do
+  "$BIN/bitcoind" -datadir="$CSDIR" -coin=$c -regtest -daemon -listen=0 -fallbackfee=0.0001 \
+     -claimsnapshot="$BTCDIR/snap.dat" -claimsnapshothash="$HASH" >/dev/null
+done
+sleep 4
+cs half -rpcwait createwallet w >/dev/null; cs quarter -rpcwait createwallet w >/dev/null
+HA=$(cs half getnewaddress); QA=$(cs quarter getnewaddress)
+cs half generatetoaddress 101 "$HA" >/dev/null; cs quarter generatetoaddress 101 "$QA" >/dev/null
+[[ $(cs half getsnapshotinfo | J "d['loaded'] and d['hash_serialized']=='$HASH'") == True ]] && pass "snapshot loaded and verified" || fail "snapshot load"
+
+inp() { echo "{\"txid\":\"${TXID[$1]}\",\"vout\":${VOUT[$1]}}"; }
+A0=${ADDRS[0]}; A1=${ADDRS[1]}; A2=${ADDRS[2]}; A3=${ADDRS[3]}; A4=${ADDRS[4]}
+[[ $(cs half getclaimable "${TXID[$A2]}" "${VOUT[$A2]}" | J "d['found'] and not d['claimed'] and d['claim_amount']==6") == True ]] \
+  && pass "getclaimable: 3 BTC -> 6 Half, unclaimed" || fail "getclaimable"
+
+# ---- 3. Claim four outputs signed with keys (path B) ----
+BAL0=$(cs half getbalance)
+C=$(cs half createclaim "[$(inp $A0),$(inp $A1),$(inp $A2),$(inp $A3)]" "[{\"$HA\":19.999}]")
+HEX=$(echo "$C" | J "d['hex']")
+S=$(cs half signclaimwithkey "$HEX" "[\"${WIFS[0]}\",\"${WIFS[1]}\",\"${WIFS[2]}\",\"${WIFS[3]}\"]")
+[[ $(echo "$S" | J "d['complete']") == True ]] && pass "signclaimwithkey: p2pkh, p2sh-p2wpkh, p2wpkh, p2tr proofs" || { fail "sign: $(echo "$S" | J "d['errors']")"; }
+SIGNED=$(echo "$S" | J "d['hex']")
+
+# Tampered output (redirect to another address) must fail
+TAMPER=$(python3 "$(dirname "$0")/tamper_output.py" "$SIGNED")
+R=$(cs half sendrawtransaction "$TAMPER" 2>&1); echo "$R" | grep -q "claim proof" && pass "tampered output rejected (proof no longer matches)" || fail "tampered: $R"
+# Same proofs on another coin (Quarter) must fail
+R=$(cs quarter sendrawtransaction "$SIGNED" 2>&1); echo "$R" | grep -q "claim proof" && pass "proofs rejected on another coin (proof invalid there)" || fail "quarter: $R"
+
+TX=$(cs half sendrawtransaction "$SIGNED") && pass "claim accepted into mempool" || fail "claim rejected"
+[[ $(cs half getclaimable "${TXID[$A0]}" "${VOUT[$A0]}" | J "d['claimed']") == True ]] && pass "claimed (mempool) visible" || fail "claimed flag"
+cs half generatetoaddress 1 "$HA" >/dev/null
+BAL1=$(cs half getbalance)
+python3 -c "import sys; d=$BAL1-$BAL0; sys.exit(0 if abs(d-(19.999+3.125*2))<1e-8 else 1)" \
+  && pass "claimed 19.999 Half received (1+2+3+4 BTC x2, fee 0.001)" || fail "balance $BAL0 -> $BAL1"
+
+# ---- 4. Double claim ----
+C2=$(cs half createclaim "[$(inp $A0)]" "[{\"$HA\":1.9}]" | J "d['hex']")
+S2=$(cs half signclaimwithkey "$C2" "[\"${WIFS[0]}\"]" | J "d['hex']")
+R=$(cs half sendrawtransaction "$S2" 2>&1); echo "$R" | grep -q "missingorspent\|missing-inputs\|conflict" && pass "double claim rejected ($R)" || fail "double: $R"
+
+# ---- 5. Wallet signature (legacy signmessage) path A ----
+C3=$(cs half createclaim "[{\"txid\":\"${TXID[$SIGNADDR]}\",\"vout\":${VOUT[$SIGNADDR]}}]" "[{\"$HA\":11.99}]")
+HEX3=$(echo "$C3" | J "d['hex']"); MSG3=$(echo "$C3" | J "d['message']")
+SIG3=$(btc -rpcwallet=signer signmessage "$SIGNADDR" "$MSG3")
+P3=$(cs half addclaimproof "$HEX3" 0 "$SIG3") && pass "Bitcoin wallet signmessage proof attached" || fail "addclaimproof"
+cs half sendrawtransaction "$P3" >/dev/null && pass "wallet-signed claim accepted" || fail "wallet-signed claim"
+cs half generatetoaddress 1 "$HA" >/dev/null
+
+# ---- 6. Normal transaction spending a snapshot output ----
+RAW=$(cs half createrawtransaction "[$(inp $A4)]" "[{\"$HA\":1}]")
+R=$(cs half sendrawtransaction "$RAW" 2>&1); echo "$R" | grep -q "spends-unclaimed-snapshot" && pass "normal tx cannot spend snapshot output" || fail "normal tx: $R"
+
+# ---- 7. Disconnect / reconnect the claim block ----
+CLAIMBLOCK=$(cs half gettransaction "$TX" | J "d['blockhash']")
+cs half invalidateblock "$CLAIMBLOCK"
+[[ $(cs half getclaimable "${TXID[$A0]}" "${VOUT[$A0]}" | J "d['claimed']") == True ]] && pass "after disconnect: claim back in mempool" || fail "disconnect"
+cs half reconsiderblock "$CLAIMBLOCK"
+[[ $(cs half gettransaction "$TX" | J "d['confirmations']>0") == True ]] && pass "reconnected" || fail "reconnect"
+
+# ---- 8. Restart: claim records persist ----
+cs half stop >/dev/null; sleep 4
+"$BIN/bitcoind" -datadir="$CSDIR" -coin=half -regtest -daemon -listen=0 -fallbackfee=0.0001 \
+   -claimsnapshot="$BTCDIR/snap.dat" -claimsnapshothash="$HASH" >/dev/null
+sleep 3
+cs half -rpcwait sendrawtransaction "$S2" >/dev/null 2>&1 && fail "double claim after restart accepted" || pass "double claim after restart rejected"
+[[ $(cs half getclaimable "${TXID[$A4]}" "${VOUT[$A4]}" | J "not d['claimed']") == True ]] && pass "unclaimed output still claimable after restart" || fail "unclaimed state"
+exit $FAIL
diff --git a/contrib/coinseries/tamper_output.py b/contrib/coinseries/tamper_output.py
new file mode 100644
index 0000000..d332bb5
--- /dev/null
+++ b/contrib/coinseries/tamper_output.py
@@ -0,0 +1,28 @@
+import sys
+# Pay 1 satoshi less on the first output of a serialized (witness) transaction.
+b = bytearray.fromhex(sys.argv[1])
+
+
+def cs(b, i):
+    v = b[i]
+    if v < 0xfd:
+        return v, i + 1
+    if v == 0xfd:
+        return int.from_bytes(b[i + 1:i + 3], 'little'), i + 3
+    if v == 0xfe:
+        return int.from_bytes(b[i + 1:i + 5], 'little'), i + 5
+    return int.from_bytes(b[i + 1:i + 9], 'little'), i + 9
+
+
+i = 4
+if b[i] == 0 and b[i + 1] == 1:
+    i += 2
+n, i = cs(b, i)
+for _ in range(n):
+    i += 36
+    l, i = cs(b, i)
+    i += l + 4
+n, i = cs(b, i)
+v = int.from_bytes(b[i:i + 8], 'little') - 1
+b[i:i + 8] = v.to_bytes(8, 'little')
+print(b.hex())
