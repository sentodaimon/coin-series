@@ -0,0 +1,54 @@
+// Copyright (c) 2026 Sento Daimon
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef BITCOIN_COINSERIES_CLAIM_H
+#define BITCOIN_COINSERIES_CLAIM_H
+
+#include <primitives/transaction.h>
+#include <script/script.h>
+#include <util/result.h>
+
+#include <string>
+#include <vector>
+
+class SigningProvider;
+
+/**
+ * Coin Series claim transactions.
+ *
+ * A claim transaction (version COIN_SERIES_CLAIM_TX_VERSION) spends only unclaimed snapshot outputs.
+ * Each input carries exactly one witness item: the ownership proof for the snapshot output's script.
+ * The proof is a BIP-322 signature (or, for P2PKH, a legacy signed message) over the claim message,
+ * which commits to the rule version, the chain and environment, the genesis block, the snapshot hash
+ * and the claim transaction id (txid covers version, every input, every output and the lock time;
+ * each input's amount and script are fixed by the committed snapshot).
+ *
+ * Proofs are verified with Bitcoin's original signature rules (no chain identifier), and they are
+ * message signatures, so they can never be valid Bitcoin transactions.
+ *
+ * Proof witness item = format byte || payload:
+ *   0x01 legacy : 65-byte compact signature (P2PKH only), Bitcoin signed message
+ *   0x02 simple : BIP-322 "simple" witness stack, consensus serialized (native SegWit / Taproot)
+ *   0x03 full   : BIP-322 "full" to_sign transaction, consensus serialized (any script)
+ * Time-locked proofs (to_sign version, lock time or sequence not zero) are not accepted.
+ */
+enum class ClaimProofFormat : uint8_t { LEGACY = 1, SIMPLE = 2, FULL = 3 };
+
+/** The exact text every ownership proof of this claim transaction signs (uses the running chain). */
+std::string ClaimMessage(const CTransaction& tx);
+
+/** Consensus: verify the ownership proof of input nIn against the snapshot output script. */
+bool VerifyClaimProof(const CTransaction& tx, unsigned int nIn, const CScript& snapshot_script, std::string& error);
+
+/**
+ * Convert a signature produced by a wallet over ClaimMessage(tx) into a proof witness item:
+ * BIP-322 strings with prefix "smp" / "ful" (unprefixed BIP-322 signatures are rejected), or a legacy
+ * base64 signed message for P2PKH outputs.
+ */
+util::Result<std::vector<unsigned char>> ParseClaimSignature(const std::string& signature, const CScript& snapshot_script);
+
+/** Produce a proof witness item with keys from the provider (the claim tool signs directly). */
+util::Result<std::vector<unsigned char>> SignClaimProof(const CTransaction& tx, const CScript& snapshot_script, const SigningProvider& provider);
+
+#endif // BITCOIN_COINSERIES_CLAIM_H
diff --git a/src/coinseries_snapshot.cpp b/src/coinseries_snapshot.cpp
new file mode 100644
index 0000000..f0bd6b9
--- /dev/null
+++ b/src/coinseries_snapshot.cpp
@@ -0,0 +1,262 @@
+// Copyright (c) 2026 Sento Daimon
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <coinseries_snapshot.h>
+
+#include <hash.h>
+#include <kernel/coinseries.h>
+#include <logging.h>
+#include <script/script.h>
+#include <serialize.h>
+#include <streams.h>
+#include <tinyformat.h>
+#include <util/fs.h>
+#include <util/time.h>
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+
+namespace {
+constexpr std::array<uint8_t, 5> SNAPSHOT_MAGIC{'u', 't', 'x', 'o', 0xff};
+constexpr uint16_t SNAPSHOT_VERSION{2};
+constexpr std::array<uint8_t, 8> INDEX_MAGIC{'c', 's', 'i', 'd', 'x', 0, 0, 1};
+//! Transaction groups per index block. ~180 million outputs -> ~140k index entries (~5.6 MB).
+constexpr uint64_t GROUPS_PER_BLOCK{1024};
+constexpr size_t BLOCK_CACHE_SIZE{16};
+constexpr size_t HEADER_SIZE{5 + 2 + 4 + 32 + 8};
+
+struct Header {
+    uint256 base_blockhash;
+    uint64_t coins_count{0};
+};
+
+Header ReadHeader(AutoFile& f)
+{
+    std::array<uint8_t, 5> magic;
+    f >> magic;
+    if (magic != SNAPSHOT_MAGIC) throw std::ios_base::failure("not a UTXO snapshot file");
+    uint16_t version;
+    f >> version;
+    if (version != SNAPSHOT_VERSION) throw std::ios_base::failure(strprintf("unsupported snapshot version %u", version));
+    std::array<uint8_t, 4> network_magic;
+    f >> network_magic;
+    Header h;
+    f >> h.base_blockhash >> h.coins_count;
+    return h;
+}
+
+/** Bitcoin Core's serialized UTXO hash serialization of one output (kernel/coinstats.cpp TxOutSer). */
+void HashCoin(HashWriter& ss, const COutPoint& outpoint, const Coin& coin)
+{
+    ss << outpoint;
+    ss << static_cast<uint32_t>((coin.nHeight << 1) + coin.fCoinBase);
+    ss << coin.out;
+}
+
+fs::path IndexPath(const fs::path& file)
+{
+    return fs::PathFromString(fs::PathToString(file) + ".csidx");
+}
+} // namespace
+
+util::Result<std::unique_ptr<ClaimSnapshot>> ClaimSnapshot::Open(const fs::path& file, const uint256& expected_hash,
+                                                                  const uint256& expected_base, int64_t multiplier)
+{
+    auto snap = std::unique_ptr<ClaimSnapshot>(new ClaimSnapshot());
+    snap->m_path = file;
+    snap->m_multiplier = multiplier;
+
+    AutoFile f{fsbridge::fopen(file, "rb")};
+    if (f.IsNull()) return util::Error{Untranslated(strprintf("Cannot open claim snapshot %s", fs::PathToString(file)))};
+    try {
+        snap->m_file_size = f.size();
+        const Header header = ReadHeader(f);
+        if (!expected_base.IsNull() && header.base_blockhash != expected_base) {
+            return util::Error{Untranslated(strprintf("Claim snapshot is for block %s, expected %s", header.base_blockhash.ToString(), expected_base.ToString()))};
+        }
+
+        // Reuse the cached index when it belongs to this file and this expected hash.
+        const fs::path index_path = IndexPath(file);
+        {
+            AutoFile idx{fsbridge::fopen(index_path, "rb")};
+            if (!idx.IsNull()) {
+                try {
+                    std::array<uint8_t, 8> magic;
+                    uint64_t file_size;
+                    uint256 hash;
+                    idx >> magic >> file_size >> hash;
+                    if (magic == INDEX_MAGIC && file_size == snap->m_file_size && hash == expected_hash) {
+                        Info info;
+                        uint64_t n;
+                        idx >> info.base_blockhash >> info.coins_count >> info.hash_serialized >> info.total_amount >> n;
+                        std::vector<IndexEntry> entries(n);
+                        for (auto& e : entries) idx >> e.first_txid >> e.offset;
+                        snap->m_info = info;
+                        snap->m_index = std::move(entries);
+                        LogInfo("Claim snapshot %s: %u outputs, verified hash %s (cached index)", fs::PathToString(file), info.coins_count, info.hash_serialized.ToString());
+                        return snap;
+                    }
+                } catch (const std::exception&) {
+                    // fall through and rebuild
+                }
+            }
+        }
+
+        // Full pass: verify the serialized hash and build the sparse index.
+        LogInfo("Verifying claim snapshot %s (%u outputs). This reads the whole file once and can take a while...", fs::PathToString(file), header.coins_count);
+        const auto start = SteadyClock::now();
+        HashWriter ss{};
+        Info info;
+        info.base_blockhash = header.base_blockhash;
+        info.coins_count = header.coins_count;
+        uint64_t coins_read = 0, groups = 0;
+        uint256 prev_txid;
+        std::vector<std::pair<uint32_t, Coin>> coins;
+        while (coins_read < header.coins_count) {
+            const uint64_t offset = f.tell();
+            uint256 txid;
+            f >> txid;
+            if (groups > 0 && !(prev_txid < txid)) {
+                return util::Error{Untranslated("Claim snapshot is not ordered by transaction id")};
+            }
+            const uint64_t count = ReadCompactSize(f);
+            if (count == 0 || count > header.coins_count - coins_read) return util::Error{Untranslated("Claim snapshot has an invalid output count")};
+            coins.clear();
+            coins.reserve(count);
+            for (uint64_t i = 0; i < count; ++i) {
+                const uint64_t n = ReadCompactSize(f);
+                if (n > std::numeric_limits<uint32_t>::max()) return util::Error{Untranslated("Claim snapshot has an invalid output index")};
+                Coin coin;
+                f >> coin;
+                if (coin.out.nValue < 0 || coin.out.nValue > BITCOIN_MAX_MONEY) return util::Error{Untranslated("Claim snapshot has an invalid amount")};
+                coins.emplace_back(static_cast<uint32_t>(n), std::move(coin));
+            }
+            std::sort(coins.begin(), coins.end(), [](const auto& a, const auto& b) { return a.first < b.first; });
+            for (const auto& [n, coin] : coins) {
+                HashCoin(ss, COutPoint{Txid::FromUint256(txid), n}, coin);
+                info.total_amount += coin.out.nValue;
+            }
+            if (groups % GROUPS_PER_BLOCK == 0) snap->m_index.push_back({txid, offset});
+            coins_read += count;
+            ++groups;
+            prev_txid = txid;
+        }
+        info.hash_serialized = ss.GetHash();
+        if (info.hash_serialized != expected_hash) {
+            return util::Error{Untranslated(strprintf("Claim snapshot hash %s does not match the consensus value %s", info.hash_serialized.ToString(), expected_hash.ToString()))};
+        }
+        snap->m_info = info;
+        LogInfo("Claim snapshot verified: %u outputs in %u transactions, hash %s, %.1fs", coins_read, groups, info.hash_serialized.ToString(),
+                Ticks<SecondsDouble>(SteadyClock::now() - start));
+
+        // Cache the index (best effort).
+        AutoFile out{fsbridge::fopen(index_path, "wb")};
+        if (!out.IsNull()) {
+            out << INDEX_MAGIC << snap->m_file_size << expected_hash;
+            out << info.base_blockhash << info.coins_count << info.hash_serialized << info.total_amount << uint64_t{snap->m_index.size()};
+            for (const auto& e : snap->m_index) out << e.first_txid << e.offset;
+            if (out.fclose() != 0) LogWarning("Could not write claim snapshot index %s", fs::PathToString(index_path));
+        }
+    } catch (const std::exception& e) {
+        return util::Error{Untranslated(strprintf("Cannot read claim snapshot %s: %s", fs::PathToString(file), e.what()))};
+    }
+    return snap;
+}
+
+std::vector<ClaimSnapshot::Group> ClaimSnapshot::ReadBlock(size_t index) const
+{
+    AssertLockHeld(m_mutex);
+    for (auto it = m_block_cache.begin(); it != m_block_cache.end(); ++it) {
+        if (it->first == index) {
+            m_block_cache.splice(m_block_cache.begin(), m_block_cache, it);
+            return m_block_cache.front().second;
+        }
+    }
+    std::vector<Group> groups;
+    AutoFile f{fsbridge::fopen(m_path, "rb")};
+    if (f.IsNull()) throw std::runtime_error("claim snapshot file disappeared");
+    f.seek(m_index[index].offset, SEEK_SET);
+    const uint64_t end = index + 1 < m_index.size() ? m_index[index + 1].offset : m_file_size;
+    while (static_cast<uint64_t>(f.tell()) < end) {
+        Group g;
+        f >> g.first;
+        const uint64_t count = ReadCompactSize(f);
+        g.second.reserve(count);
+        for (uint64_t i = 0; i < count; ++i) {
+            const uint32_t n = static_cast<uint32_t>(ReadCompactSize(f));
+            Coin coin;
+            f >> coin;
+            g.second.emplace_back(n, std::move(coin));
+        }
+        groups.push_back(std::move(g));
+    }
+    m_block_cache.emplace_front(index, groups);
+    while (m_block_cache.size() > BLOCK_CACHE_SIZE) m_block_cache.pop_back();
+    return groups;
+}
+
+std::optional<Coin> ClaimSnapshot::Lookup(const COutPoint& outpoint) const
+{
+    if (m_index.empty()) return std::nullopt;
+    const uint256 target = outpoint.hash.ToUint256();
+    // Last index block whose first txid <= target.
+    auto it = std::upper_bound(m_index.begin(), m_index.end(), target, [](const uint256& t, const IndexEntry& e) { return t < e.first_txid; });
+    if (it == m_index.begin()) return std::nullopt;
+    const size_t block = std::distance(m_index.begin(), it) - 1;
+    LOCK(m_mutex);
+    try {
+        const auto groups = ReadBlock(block);
+        auto g = std::lower_bound(groups.begin(), groups.end(), target, [](const Group& a, const uint256& t) { return a.first < t; });
+        if (g == groups.end() || g->first != target) return std::nullopt;
+        for (const auto& [n, coin] : g->second) {
+            if (n == outpoint.n) return coin;
+        }
+    } catch (const std::exception& e) {
+        LogError("Claim snapshot read error: %s", e.what());
+    }
+    return std::nullopt;
+}
+
+COutPoint ClaimMarkerOutpoint(const COutPoint& snapshot_outpoint)
+{
+    HashWriter hw = TaggedHash("coin-series/claimed");
+    hw << snapshot_outpoint;
+    return COutPoint{Txid::FromUint256(hw.GetSHA256()), 0};
+}
+
+Coin ClaimMarkerCoin(int height)
+{
+    return Coin{CTxOut{0, CScript() << OP_FALSE}, height, /*fCoinBaseIn=*/false};
+}
+
+std::optional<Coin> CClaimSnapshotView::Synthesize(const COutPoint& outpoint) const
+{
+    const ClaimSnapshot* snap = g_claim_snapshot.get();
+    if (!snap) return std::nullopt;
+    auto coin = snap->Lookup(outpoint);
+    if (!coin) return std::nullopt;
+    if (base->HaveCoin(ClaimMarkerOutpoint(outpoint))) return std::nullopt; // already claimed on this chain
+    Coin synth{CTxOut{coin->out.nValue * snap->Multiplier(), coin->out.scriptPubKey}, COIN_SERIES_CLAIM_COIN_HEIGHT, /*fCoinBaseIn=*/false};
+    return synth;
+}
+
+std::optional<Coin> CClaimSnapshotView::GetCoin(const COutPoint& outpoint) const
+{
+    if (auto coin = base->GetCoin(outpoint)) return coin;
+    return Synthesize(outpoint);
+}
+
+std::optional<Coin> CClaimSnapshotView::PeekCoin(const COutPoint& outpoint) const
+{
+    if (auto coin = base->PeekCoin(outpoint)) return coin;
+    return Synthesize(outpoint);
+}
+
+bool CClaimSnapshotView::HaveCoin(const COutPoint& outpoint) const
+{
+    return base->HaveCoin(outpoint) || Synthesize(outpoint).has_value();
+}
diff --git a/src/coinseries_snapshot.h b/src/coinseries_snapshot.h
new file mode 100644
index 0000000..2f37f13
--- /dev/null
+++ b/src/coinseries_snapshot.h
@@ -0,0 +1,103 @@
+// Copyright (c) 2026 Sento Daimon
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef BITCOIN_COINSERIES_SNAPSHOT_H
+#define BITCOIN_COINSERIES_SNAPSHOT_H
+
+#include <coins.h>
+#include <consensus/amount.h>
+#include <primitives/transaction.h>
+#include <sync.h>
+#include <uint256.h>
+#include <util/fs.h>
+#include <util/result.h>
+
+#include <cstdint>
+#include <list>
+#include <memory>
+#include <optional>
+#include <utility>
+#include <vector>
+
+/**
+ * Coin Series claim snapshot: the Bitcoin UTXO set at the snapshot height, in Bitcoin Core's
+ * UTXO snapshot file format (dumptxoutset / loadtxoutset, format version 2). One read-only file is
+ * shared by all five chains.
+ *
+ * The file is verified once against the consensus value (the same serialized-hash Bitcoin Core
+ * uses for assumeutxo) and a small sparse index (every Nth transaction group) is written next to it.
+ * Lookups binary-search the index and decode one group block from the file.
+ */
+class ClaimSnapshot
+{
+public:
+    struct Info {
+        uint256 base_blockhash;  //!< Bitcoin block the snapshot was taken at
+        uint64_t coins_count{0};
+        uint256 hash_serialized; //!< verified serialized hash of the UTXO set
+        CAmount total_amount{0}; //!< sum of all output amounts (Bitcoin units)
+    };
+
+    /**
+     * Open and verify a snapshot. expected_base may be null (development snapshots).
+     * Verification and index building read the whole file once; the result is cached in
+     * "<file>.csidx" and reused while file size and expected hash match.
+     */
+    static util::Result<std::unique_ptr<ClaimSnapshot>> Open(const fs::path& file, const uint256& expected_hash,
+                                                             const uint256& expected_base, int64_t multiplier);
+
+    /** Look up an output as it existed in Bitcoin at the snapshot height. */
+    std::optional<Coin> Lookup(const COutPoint& outpoint) const EXCLUSIVE_LOCKS_REQUIRED(!m_mutex);
+
+    const Info& GetInfo() const { return m_info; }
+    int64_t Multiplier() const { return m_multiplier; }
+    const fs::path& Path() const { return m_path; }
+
+    struct IndexEntry {
+        uint256 first_txid; //!< txid of the first group in this block (internal byte order)
+        uint64_t offset;    //!< file offset of that group
+    };
+
+private:
+    using Group = std::pair<uint256, std::vector<std::pair<uint32_t, Coin>>>;
+    std::vector<Group> ReadBlock(size_t index) const EXCLUSIVE_LOCKS_REQUIRED(m_mutex);
+
+    fs::path m_path;
+    Info m_info;
+    int64_t m_multiplier{1};
+    uint64_t m_file_size{0};
+    std::vector<IndexEntry> m_index;
+
+    mutable Mutex m_mutex;
+    //! Small cache of recently decoded index blocks (most recent first).
+    mutable std::list<std::pair<size_t, std::vector<Group>>> m_block_cache GUARDED_BY(m_mutex);
+};
+
+/** The snapshot of the running chain (null when claims are not available). Set once at startup. */
+inline std::unique_ptr<ClaimSnapshot> g_claim_snapshot;
+
+/** Outpoint of the marker coin recording that a snapshot output has been claimed on this chain. */
+COutPoint ClaimMarkerOutpoint(const COutPoint& snapshot_outpoint);
+/** Marker coin: zero value, unspendable script (OP_FALSE). */
+Coin ClaimMarkerCoin(int height);
+
+/**
+ * Coins view layer that makes unclaimed snapshot outputs visible as coins:
+ * value = snapshot amount x multiplier, height = COIN_SERIES_CLAIM_COIN_HEIGHT.
+ * A snapshot output is hidden once its claim marker exists in the layer below (the database).
+ * Coins present in the layer below always take precedence.
+ */
+class CClaimSnapshotView final : public CCoinsViewBacked
+{
+public:
+    explicit CClaimSnapshotView(CCoinsView* view) : CCoinsViewBacked(view) {}
+    std::optional<Coin> GetCoin(const COutPoint& outpoint) const override;
+    std::optional<Coin> PeekCoin(const COutPoint& outpoint) const override;
+    bool HaveCoin(const COutPoint& outpoint) const override;
+
+private:
+    std::optional<Coin> Synthesize(const COutPoint& outpoint) const;
+};
+
+#endif // BITCOIN_COINSERIES_SNAPSHOT_H
diff --git a/src/consensus/params.h b/src/consensus/params.h
index ebfdc92..ace0dfd 100644
