diff --git a/src/coinseries_claim.cpp b/src/coinseries_claim.cpp
new file mode 100644
index 0000000..0e467fb
--- /dev/null
+++ b/src/coinseries_claim.cpp
@@ -0,0 +1,215 @@
+// Copyright (c) 2026 Sento Daimon
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <coinseries_claim.h>
+
+#include <addresstype.h>
+#include <chainparams.h>
+#include <common/signmessage.h>
+#include <hash.h>
+#include <kernel/coinseries.h>
+#include <pubkey.h>
+#include <script/interpreter.h>
+#include <script/sign.h>
+#include <script/signingprovider.h>
+#include <script/solver.h>
+#include <streams.h>
+#include <tinyformat.h>
+#include <util/strencodings.h>
+
+#include <variant>
+
+namespace {
+const script_verify_flags BIP322_FLAGS =
+    SCRIPT_VERIFY_P2SH | SCRIPT_VERIFY_WITNESS | SCRIPT_VERIFY_DERSIG | SCRIPT_VERIFY_STRICTENC |
+    SCRIPT_VERIFY_LOW_S | SCRIPT_VERIFY_NULLFAIL | SCRIPT_VERIFY_MINIMALDATA | SCRIPT_VERIFY_CLEANSTACK |
+    SCRIPT_VERIFY_MINIMALIF | SCRIPT_VERIFY_NULLDUMMY | SCRIPT_VERIFY_CONST_SCRIPTCODE |
+    SCRIPT_VERIFY_TAPROOT | SCRIPT_VERIFY_CHECKLOCKTIMEVERIFY | SCRIPT_VERIFY_CHECKSEQUENCEVERIFY |
+    SCRIPT_VERIFY_WITNESS_PUBKEYTYPE |
+    // BIP-322 "upgradeable rules": anything they reject would be "inconclusive", which a claim treats as invalid.
+    SCRIPT_VERIFY_DISCOURAGE_UPGRADABLE_NOPS | SCRIPT_VERIFY_DISCOURAGE_UPGRADABLE_WITNESS_PROGRAM |
+    SCRIPT_VERIFY_DISCOURAGE_UPGRADABLE_TAPROOT_VERSION | SCRIPT_VERIFY_DISCOURAGE_OP_SUCCESS |
+    SCRIPT_VERIFY_DISCOURAGE_UPGRADABLE_PUBKEYTYPE;
+
+uint256 Bip322MessageHash(const std::string& msg)
+{
+    HashWriter hw = TaggedHash("BIP0322-signed-message");
+    hw.write(std::as_bytes(std::span{msg.data(), msg.size()}));
+    return hw.GetSHA256();
+}
+
+CMutableTransaction ToSpend(const std::string& message, const CScript& challenge)
+{
+    CMutableTransaction tx;
+    tx.version = 0;
+    tx.nLockTime = 0;
+    CTxIn in;
+    in.prevout = COutPoint(Txid{}, 0xFFFFFFFF);
+    in.nSequence = 0;
+    const uint256 mh = Bip322MessageHash(message);
+    in.scriptSig = CScript() << OP_0 << std::vector<unsigned char>(mh.begin(), mh.end());
+    tx.vin.push_back(in);
+    tx.vout.emplace_back(0, challenge);
+    return tx;
+}
+
+CMutableTransaction ToSign(const Txid& to_spend_id)
+{
+    CMutableTransaction tx;
+    tx.version = 0;
+    tx.nLockTime = 0;
+    CTxIn in;
+    in.prevout = COutPoint(to_spend_id, 0);
+    in.nSequence = 0;
+    tx.vin.push_back(in);
+    tx.vout.emplace_back(0, CScript() << OP_RETURN);
+    return tx;
+}
+
+bool IsNativeSegwit(const CScript& script)
+{
+    int version;
+    std::vector<unsigned char> program;
+    return script.IsWitnessProgram(version, program) && (version == 0 || version == 1);
+}
+
+bool VerifyBip322(const std::string& message, const CScript& challenge, const CMutableTransaction& to_sign_in, std::string& error)
+{
+    const CMutableTransaction to_spend = ToSpend(message, challenge);
+    const CMutableTransaction& to_sign = to_sign_in;
+    if (to_sign.vin.size() != 1 || to_sign.vin[0].prevout != COutPoint(to_spend.GetHash(), 0)) { error = "proof does not spend the message commitment"; return false; }
+    if (to_sign.vout.size() != 1 || to_sign.vout[0].nValue != 0 || to_sign.vout[0].scriptPubKey != (CScript() << OP_RETURN)) { error = "proof output malformed"; return false; }
+    if (to_sign.version != 0 || to_sign.nLockTime != 0 || to_sign.vin[0].nSequence != 0) { error = "time-locked proofs are not accepted"; return false; }
+    // Bitcoin's original signature rules: no Coin Series chain identifier.
+    SighashChainIdScope bitcoin_rules{0};
+    PrecomputedTransactionData txdata;
+    txdata.Init(to_sign, {to_spend.vout[0]}, /*force=*/true);
+    MutableTransactionSignatureChecker checker(&to_sign, 0, 0, txdata, MissingDataBehavior::FAIL);
+    ScriptError serror;
+    if (!VerifyScript(to_sign.vin[0].scriptSig, challenge, &to_sign.vin[0].scriptWitness, BIP322_FLAGS, checker, &serror)) {
+        error = std::string("proof signature invalid: ") + ScriptErrorString(serror);
+        return false;
+    }
+    return true;
+}
+
+std::string ChainLabel()
+{
+    const auto& params = Params();
+    const int slot = params.GetConsensus().nMergeSlot;
+    std::string coin = "bitcoin";
+    for (const auto& info : COIN_TABLE) {
+        if (info.merge_slot == slot) coin = std::string{info.name};
+    }
+    const auto env = CoinEnvFromChainType(params.GetChainType());
+    return coin + "-" + (env ? std::string{CoinEnvName(*env)} : params.GetChainTypeString());
+}
+} // namespace
+
+std::string ClaimMessage(const CTransaction& tx)
+{
+    const auto& consensus = Params().GetConsensus();
+    return strprintf("Coin Series claim v1\nchain: %s\ngenesis: %s\nsnapshot: %s\ntransaction: %s",
+                     ChainLabel(), consensus.hashGenesisBlock.GetHex(), consensus.hashSnapshotUtxoSet.GetHex(), tx.GetHash().GetHex());
+}
+
+bool VerifyClaimProof(const CTransaction& tx, unsigned int nIn, const CScript& snapshot_script, std::string& error)
+{
+    const auto& stack = tx.vin.at(nIn).scriptWitness.stack;
+    if (stack.size() != 1 || stack[0].empty() || stack[0].size() > COIN_SERIES_MAX_CLAIM_PROOF_SIZE) { error = "claim input must carry exactly one proof"; return false; }
+    if (!tx.vin[nIn].scriptSig.empty()) { error = "claim input scriptSig must be empty"; return false; }
+    const auto format = static_cast<ClaimProofFormat>(stack[0][0]);
+    const std::span<const unsigned char> payload{stack[0].data() + 1, stack[0].size() - 1};
+    const std::string message = ClaimMessage(tx);
+
+    switch (format) {
+    case ClaimProofFormat::LEGACY: {
+        // Legacy signed message: P2PKH outputs only.
+        std::vector<std::vector<unsigned char>> solutions;
+        if (Solver(snapshot_script, solutions) != TxoutType::PUBKEYHASH) { error = "legacy proofs are only for P2PKH outputs"; return false; }
+        if (payload.size() != 65) { error = "legacy proof must be 65 bytes"; return false; }
+        CPubKey pubkey;
+        if (!pubkey.RecoverCompact(MessageHash(message), std::vector<unsigned char>(payload.begin(), payload.end()))) { error = "legacy proof signature invalid"; return false; }
+        if (!std::equal(solutions[0].begin(), solutions[0].end(), PKHash(pubkey).begin())) { error = "legacy proof key does not match the output"; return false; }
+        return true;
+    }
+    case ClaimProofFormat::SIMPLE: {
+        if (!IsNativeSegwit(snapshot_script)) { error = "simple proofs are only for native SegWit / Taproot outputs"; return false; }
+        CMutableTransaction to_sign = ToSign(ToSpend(message, snapshot_script).GetHash());
+        try {
+            SpanReader reader{payload};
+            reader >> to_sign.vin[0].scriptWitness.stack;
+            if (!reader.empty()) { error = "trailing data in proof"; return false; }
+        } catch (const std::exception&) { error = "malformed simple proof"; return false; }
+        return VerifyBip322(message, snapshot_script, to_sign, error);
+    }
+    case ClaimProofFormat::FULL: {
+        CMutableTransaction to_sign;
+        try {
+            SpanReader reader{payload};
+            reader >> TX_WITH_WITNESS(to_sign);
+            if (!reader.empty()) { error = "trailing data in proof"; return false; }
+        } catch (const std::exception&) { error = "malformed full proof"; return false; }
+        return VerifyBip322(message, snapshot_script, to_sign, error);
+    }
+    }
+    error = "unknown proof format";
+    return false;
+}
+
+util::Result<std::vector<unsigned char>> ParseClaimSignature(const std::string& signature, const CScript& snapshot_script)
+{
+    const std::string prefix = signature.substr(0, 3);
+    std::vector<unsigned char> item;
+    if (prefix == "smp" || prefix == "ful") {
+        auto raw = DecodeBase64(signature.substr(3));
+        if (!raw) return util::Error{Untranslated("signature is not valid base64")};
+        item.push_back(static_cast<unsigned char>(prefix == "smp" ? ClaimProofFormat::SIMPLE : ClaimProofFormat::FULL));
+        item.insert(item.end(), raw->begin(), raw->end());
+    } else if (prefix == "pof") {
+        return util::Error{Untranslated("proof-of-funds signatures are not used for claims; sign the claim message with the simple or full format")};
+    } else {
+        auto raw = DecodeBase64(signature);
+        if (!raw) return util::Error{Untranslated("signature is not valid base64")};
+        std::vector<std::vector<unsigned char>> solutions;
+        if (raw->size() == 65 && Solver(snapshot_script, solutions) == TxoutType::PUBKEYHASH) {
+            item.push_back(static_cast<unsigned char>(ClaimProofFormat::LEGACY));
+            item.insert(item.end(), raw->begin(), raw->end());
+        } else {
+            // Unprefixed BIP-322 signatures (pre-final format) are deliberately not accepted.
+            return util::Error{Untranslated("unprefixed signature: use a BIP-322 signature starting with smp or ful, or a legacy signed message for P2PKH")};
+        }
+    }
+    if (item.size() > COIN_SERIES_MAX_CLAIM_PROOF_SIZE) return util::Error{Untranslated("proof too large")};
+    return item;
+}
+
+util::Result<std::vector<unsigned char>> SignClaimProof(const CTransaction& tx, const CScript& snapshot_script, const SigningProvider& provider)
+{
+    const std::string message = ClaimMessage(tx);
+    const CMutableTransaction to_spend = ToSpend(message, snapshot_script);
+    CMutableTransaction to_sign = ToSign(to_spend.GetHash());
+    SighashChainIdScope bitcoin_rules{0};
+    PrecomputedTransactionData txdata;
+    txdata.Init(to_sign, {to_spend.vout[0]}, /*force=*/true);
+    SignatureData sigdata;
+    MutableTransactionSignatureCreator creator(to_sign, 0, 0, &txdata, SIGHASH_DEFAULT);
+    if (!ProduceSignature(provider, creator, snapshot_script, sigdata)) {
+        return util::Error{Untranslated("cannot sign: the provided keys do not control this output")};
+    }
+    std::vector<unsigned char> item;
+    if (IsNativeSegwit(snapshot_script)) {
+        item.push_back(static_cast<unsigned char>(ClaimProofFormat::SIMPLE));
+        DataStream ds{};
+        ds << sigdata.scriptWitness.stack;
+        item.insert(item.end(), UCharCast(ds.data()), UCharCast(ds.data() + ds.size()));
+    } else {
+        UpdateInput(to_sign.vin[0], sigdata);
+        item.push_back(static_cast<unsigned char>(ClaimProofFormat::FULL));
+        DataStream ds{};
+        ds << TX_WITH_WITNESS(to_sign);
+        item.insert(item.end(), UCharCast(ds.data()), UCharCast(ds.data() + ds.size()));
+    }
+    return item;
+}
