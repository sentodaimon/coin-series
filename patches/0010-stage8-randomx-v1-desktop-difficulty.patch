+    if (chain != ChainType::REGTEST && randomx_version != 1) throw std::runtime_error("Main and test networks use RandomX version 1; -randomxversion=2 is for regtest only");
     const CoinInfo* info = GetCoinInfo(coin);
     const auto env = CoinEnvFromChainType(chain);
     if (!info || !env) {
