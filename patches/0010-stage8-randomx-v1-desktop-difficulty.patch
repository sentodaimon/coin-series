     argsman.AddArg("-claimsnapshothash=<hex>", "Coin Series regtest: serialized UTXO hash of a development claim snapshot", ArgsManager::ALLOW_ANY | ArgsManager::DEBUG_ONLY, OptionsCategory::DEBUG_TEST);
     argsman.AddArg("-allowmissingsnapshot", "Coin Series development: start main/test without the claim snapshot (claims impossible)", ArgsManager::ALLOW_ANY | ArgsManager::DEBUG_ONLY, OptionsCategory::DEBUG_TEST);
     argsman.AddArg("-coinseriesasert", "Coin Series regtest: use the real difficulty rules (ASERT + stall relief) instead of fixed easiest difficulty (default: 0)", ArgsManager::ALLOW_ANY | ArgsManager::DEBUG_ONLY, OptionsCategory::DEBUG_TEST);
-    argsman.AddArg("-randomxversion=<n>", "Coin Series development: RandomX version for proof of work, 1 or 2 (default: 1). All nodes of a network must use the same value.", ArgsManager::ALLOW_ANY | ArgsManager::DEBUG_ONLY, OptionsCategory::CHAINPARAMS);
+    argsman.AddArg("-randomxversion=<n>", "Coin Series regtest: RandomX version for proof of work, 1 or 2 (default: 1). Main and test always use version 1.", ArgsManager::ALLOW_ANY | ArgsManager::DEBUG_ONLY, OptionsCategory::CHAINPARAMS);
     argsman.AddArg("-coin=<coin>", "Coin Series: run the chain of <coin>. Allowed values: " LIST_COIN_NAMES ". Combine with -chain=main, test or regtest. Without -coin the software runs original Bitcoin (for regression testing only).", ArgsManager::ALLOW_ANY, OptionsCategory::CHAINPARAMS);
     argsman.AddArg("-chain=<chain>", "Use the chain <chain> (default: main). Allowed values: " LIST_CHAIN_NAMES, ArgsManager::ALLOW_ANY, OptionsCategory::CHAINPARAMS);
     argsman.AddArg("-regtest", "Enter regression test mode, which uses a special chain in which blocks can be solved instantly. "
diff --git a/src/kernel/chainparams.cpp b/src/kernel/chainparams.cpp
index 3531c02..5d3b61f 100644
--- a/src/kernel/chainparams.cpp
+++ b/src/kernel/chainparams.cpp
@@ -879,6 +879,8 @@ public:
 std::unique_ptr<const CChainParams> CChainParams::CoinSeries(CoinSeriesId coin, ChainType chain, const RegTestOptions& regtest_options, int randomx_version, std::optional<CoinSeriesBeacon> beacon)
 {
     if (randomx_version != 1 && randomx_version != 2) throw std::runtime_error("RandomX version must be 1 or 2");
