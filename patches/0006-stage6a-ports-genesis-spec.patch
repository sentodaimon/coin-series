+++ b/contrib/coinseries/genesis_smoke.sh
@@ -0,0 +1,40 @@
+#!/usr/bin/env bash
+# Coin Series fair-start smoke test (regtest): nodes started with the same Bitcoin reference header
+# derive the same genesis and sync; a node given a different header is on a different chain.
+# Usage: contrib/coinseries/genesis_smoke.sh <build/bin>
+set -uo pipefail
+BIN=${1:-build/bin}
+mk() { python3 - "$1" <<'EOF'
+import hashlib, struct, time, sys
+t = int(time.time()) - 3600
+n = int(sys.argv[1])
+def h(n):
+    return struct.pack('<i', 0x20000000) + bytes(32) + bytes([9]) + bytes(31) + struct.pack('<III', t, 0x207fffff, n)
+while int.from_bytes(hashlib.sha256(hashlib.sha256(h(n)).digest()).digest(), 'little') > 0x7fffff << (8 * 29):
+    n += 1
+print(h(n).hex())
+EOF
+}
+HDR=$(mk 0); HDR2=$(mk 5000)
+A=$(mktemp -d); B=$(mktemp -d); C=$(mktemp -d)
+CA=("$BIN/bitcoin-cli" -datadir="$A" -coin=dime -regtest)
+CB=("$BIN/bitcoin-cli" -datadir="$B" -coin=dime -regtest -rpcport=23998)
+CC=("$BIN/bitcoin-cli" -datadir="$C" -coin=dime -regtest -rpcport=23997)
+cleanup() { "${CA[@]}" stop >/dev/null 2>&1; "${CB[@]}" stop >/dev/null 2>&1; "${CC[@]}" stop >/dev/null 2>&1; sleep 3; rm -rf "$A" "$B" "$C"; }
+trap cleanup EXIT
+"$BIN/bitcoind" -datadir="$A" -coin=dime -regtest -beaconheader="$HDR" -daemon -listen=1 >/dev/null
+"$BIN/bitcoind" -datadir="$B" -coin=dime -regtest -beaconheader="$HDR" -daemon -listen=0 -rpcport=23998 -connect=127.0.0.1:23310 >/dev/null
+"$BIN/bitcoind" -datadir="$C" -coin=dime -regtest -beaconheader="$HDR2" -daemon -listen=0 -rpcport=23997 -connect=127.0.0.1:23310 >/dev/null
+sleep 4
+"${CA[@]}" -rpcwait createwallet w >/dev/null
+"${CA[@]}" generatetoaddress 10 "$("${CA[@]}" getnewaddress)" >/dev/null
+sleep 8
+GA=$("${CA[@]}" getblockhash 0); GB=$("${CB[@]}" -rpcwait getblockhash 0); GC=$("${CC[@]}" -rpcwait getblockhash 0)
+HA=$("${CA[@]}" getblockcount); HB=$("${CB[@]}" getblockcount); HC=$("${CC[@]}" getblockcount)
+echo "A: genesis ${GA:0:16} height $HA"
+echo "B: genesis ${GB:0:16} height $HB (same block H)"
+echo "C: genesis ${GC:0:16} height $HC (different block H)"
+FAIL=0
+[[ "$GA" == "$GB" && "$HB" == "$HA" ]] && echo "PASS  same block H -> same genesis, synced" || { echo "FAIL  same H"; FAIL=1; }
+[[ "$GA" != "$GC" && "$HC" == 0 ]] && echo "PASS  different block H -> different chain, nothing synced" || { echo "FAIL  different H"; FAIL=1; }
+exit $FAIL
