+/**
+ * Coin Series fair start: parse the 80-byte header of Bitcoin block H (hex, as printed by
+ * "bitcoin-cli getblockheader <hash> false"). On main and test the header must carry real
+ * Bitcoin proof of work (target at most 2^200), so a made-up hash cannot be passed off.
+ */
+static CChainParams::CoinSeriesBeacon ParseBeaconHeader(const std::string& hex, ChainType chain)
+{
+    const auto bytes = TryParseHex<uint8_t>(hex);
+    if (!bytes || bytes->size() != 80) throw std::runtime_error("-beaconheader must be the 80-byte Bitcoin block header in hex");
+    CBlockHeader header;
+    {
+        SpanReader reader{*bytes};
+        reader >> header.nVersion >> header.hashPrevBlock >> header.hashMerkleRoot >> header.nTime >> header.nBits >> header.nNonce;
+    }
+    const uint256 hash = header.GetHashInFormat(/*coin_series=*/false);
+    arith_uint256 target;
+    bool negative, overflow;
+    target.SetCompact(header.nBits, &negative, &overflow);
+    const bool real_network = chain != ChainType::REGTEST;
+    const arith_uint256 max_target = real_network ? (arith_uint256{1} << 200) : ~arith_uint256{0};
+    if (negative || overflow || target == 0 || target > max_target || UintToArith256(hash) > target) {
+        throw std::runtime_error("-beaconheader does not carry valid Bitcoin proof of work");
+    }
+    LogInfo("Coin Series fair start: genesis derived from Bitcoin block %s (time %u)", hash.GetHex(), header.nTime);
+    return {hash, header.nTime};
+}
