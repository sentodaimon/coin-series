+class CBlockHeader;
+namespace Consensus { struct Params; }
+
+/**
+ * Coin Series proof of work: RandomX over a five-chain merge tree.
+ *
+ *  1. commitment c = SHA256d("coin-series/commit" || 76-byte header body)
+ *     body = nVersion(4, LE) || hashPrevBlock(32) || hashMerkleRoot(32) || nTime(4, LE) || nBits(4, LE)
+ *  2. merge tree: 8 leaves, slot s holds the commitment of the chain with merge slot s
+ *     (Half 0, Quarter 1, Dime 2, Nickel 3, Cent 4), unused leaves are zero.
+ *     inner node = SHA256d(left || right). The header carries the 3 sibling hashes on the
+ *     path from the chain's own slot to the root (leaf level first).
+ *  3. key = SHA256("coin-series/randomx" || epoch(8, LE)), epoch = nTime / 1209600 (2 weeks)
+ *  4. pow = RandomX(key, root(32) || nNonce64(8, LE)); valid if pow (as a little-endian 256-bit
+ *     number, like Bitcoin block hashes) <= target(nBits) and target <= powLimit.
+ *
+ * The block identifier remains SHA256d of the full serialized header (body + PoW section).
+ */
+
+static constexpr int64_t COIN_SERIES_RANDOMX_EPOCH_SECONDS{1209600};
+static constexpr int COIN_SERIES_MERGE_LEAVES{8};
+
+uint256 CoinSeriesCommitHash(const CBlockHeader& header);
+uint256 CoinSeriesMergeRoot(const uint256& leaf, int slot, const std::array<uint256, 3>& branch);
+uint256 CoinSeriesMergeRootFromLeaves(const std::array<uint256, COIN_SERIES_MERGE_LEAVES>& leaves);
+std::array<uint256, 3> CoinSeriesMergeBranch(const std::array<uint256, COIN_SERIES_MERGE_LEAVES>& leaves, int slot);
+uint256 CoinSeriesRandomXKey(uint32_t time);
+/** RandomX hash (light mode, cached per key). Thread safe. version is 1 or 2. */
+uint256 CoinSeriesRandomXHash(int version, const uint256& key, const uint256& root, uint64_t nonce);
+/** Proof-of-work hash of a Coin Series header for the given chain. */
+uint256 CoinSeriesPowHash(const CBlockHeader& header, const Consensus::Params& params);
+/** Full proof-of-work check of a Coin Series header (merge tree + RandomX + target). */
+bool CheckCoinSeriesProofOfWork(const CBlockHeader& header, const Consensus::Params& params);
+
+#endif // BITCOIN_COINSERIES_POW_H
