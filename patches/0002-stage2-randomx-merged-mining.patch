@@ -0,0 +1,60 @@
+#!/usr/bin/env bash
+# Coin Series merged-mining smoke test (regtest):
+#  - five nodes, one merged miner mining all five chains with one RandomX computation per nonce
+#  - every chain must advance, blocks must survive a node restart (block index on disk)
+#  - a second Half node must sync the merged-mined chain over P2P (180-byte headers)
+# Usage: contrib/coinseries/merge_smoke.sh <build/bin> <librandomx.so> [randomx version]
+set -euo pipefail
+BIN=${1:-build/bin}
+LIB=${2:?path to librandomx shared library}
+RXV=${3:-1}
+HERE=$(cd "$(dirname "$0")" && pwd)
+WORK=$(mktemp -d)
+WORK2=$(mktemp -d)
+COINS="half quarter dime nickel cent"
+cleanup() {
+  for c in $COINS; do "$BIN/bitcoin-cli" -datadir="$WORK" -coin=$c -regtest stop >/dev/null 2>&1 || true; done
+  "$BIN/bitcoin-cli" -datadir="$WORK2" -coin=half -regtest -rpcport=58999 stop >/dev/null 2>&1 || true
+  sleep 3; rm -rf "$WORK" "$WORK2"
+}
+trap cleanup EXIT
+FAIL=0
+cli() { local c=$1; shift; "$BIN/bitcoin-cli" -datadir="$WORK" -coin=$c -regtest "$@"; }
+
+for c in $COINS; do "$BIN/bitcoind" -datadir="$WORK" -coin=$c -regtest -randomxversion=$RXV -daemon -listen=1 >/dev/null; done
+sleep 3
+ARGS=()
+for c in $COINS; do
+  cli $c -rpcwait createwallet w >/dev/null
+  ARGS+=(--coin "$c=$(cli $c getnewaddress)")
+done
+
+python3 "$HERE/merge_miner.py" --lib "$LIB" --chain regtest --datadir "$WORK" --blocks 20 --refresh 5 "${ARGS[@]}" | tail -4
+
+declare -A H
+for c in $COINS; do
+  H[$c]=$(cli $c getblockcount)
+  BAL=$(cli $c getbalances | python3 -c "import sys,json;b=json.load(sys.stdin)['mine'];print(b['trusted']+b['immature'])")
+  echo "$c height=${H[$c]} total_reward=$BAL"
+  [[ ${H[$c]} -ge 20 ]] || FAIL=1
+done
+
+# Header of a merged-mined block shows the merge branch and 64-bit nonce.
+cli dime getblockheader "$(cli dime getbestblockhash)" | python3 -c "
+import sys,json; h=json.load(sys.stdin); print('dime header keys:', sorted(k for k in h if k in ('nonce','nonce64','mergebranch')))"
+
+# Restart Half: chain must reload from disk with the new header format.
+BEST=$(cli half getbestblockhash)
+cli half stop >/dev/null; sleep 4
+"$BIN/bitcoind" -datadir="$WORK" -coin=half -regtest -randomxversion=$RXV -daemon -listen=1 >/dev/null
+sleep 2
+if [[ "$(cli half -rpcwait getbestblockhash)" == "$BEST" ]]; then echo "restart reload: PASS"; else echo "restart reload: FAIL"; FAIL=1; fi
+
+# A fresh Half node syncs the chain over P2P.
+"$BIN/bitcoind" -datadir="$WORK2" -coin=half -regtest -randomxversion=$RXV -daemon -listen=0 -rpcport=58999 -connect=127.0.0.1:58302 >/dev/null
+for i in $(seq 1 60); do
+  N=$("$BIN/bitcoin-cli" -datadir="$WORK2" -coin=half -regtest -rpcport=58999 -rpcwait getblockcount)
+  [[ "$N" == "${H[half]}" ]] && break; sleep 1
+done
+if [[ "$N" == "${H[half]}" ]]; then echo "p2p sync ($N blocks): PASS"; else echo "p2p sync: FAIL ($N of ${H[half]})"; FAIL=1; fi
+exit $FAIL
