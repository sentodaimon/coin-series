@@ -0,0 +1,148 @@
+// Copyright (c) 2026 Sento Daimon
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <coinseries_pow.h>
+
+#include <arith_uint256.h>
+#include <consensus/params.h>
+#include <crypto/common.h>
+#include <crypto/sha256.h>
+#include <hash.h>
+#include <pow.h>
+#include <primitives/block.h>
+#include <sync.h>
+
+#include <randomx.h>
+
+#include <list>
+#include <memory>
+#include <stdexcept>
+#include <string_view>
+
+namespace {
+constexpr std::string_view COMMIT_TAG{"coin-series/commit"};
+constexpr std::string_view KEY_TAG{"coin-series/randomx"};
+
+/** One initialized RandomX cache (light mode, ~256 MiB) with its virtual machine. */
+struct RandomXContext {
+    int version;
+    uint256 key;
+    randomx_cache* cache{nullptr};
+    randomx_vm* vm{nullptr};
+    RandomXContext(int ver, const uint256& k) : version{ver}, key{k}
+    {
+        randomx_flags flags = randomx_get_flags();
+        if (ver == 2) flags = flags | RANDOMX_FLAG_V2;
+        cache = randomx_alloc_cache(flags);
+        if (!cache) { // e.g. JIT not permitted: fall back to portable settings
+            flags = RANDOMX_FLAG_DEFAULT;
+            if (ver == 2) flags = flags | RANDOMX_FLAG_V2;
+            cache = randomx_alloc_cache(flags);
+        }
+        if (!cache) throw std::runtime_error("RandomX: cannot allocate cache");
+        randomx_init_cache(cache, key.begin(), key.size());
+        vm = randomx_create_vm(flags, cache, nullptr);
+        if (!vm) {
+            randomx_release_cache(cache);
+            throw std::runtime_error("RandomX: cannot create virtual machine");
+        }
+    }
+    ~RandomXContext()
+    {
+        if (vm) randomx_destroy_vm(vm);
+        if (cache) randomx_release_cache(cache);
+    }
+    RandomXContext(const RandomXContext&) = delete;
+    RandomXContext& operator=(const RandomXContext&) = delete;
+};
+
+Mutex g_randomx_mutex;
+//! Most recently used first. Two entries cover an epoch boundary without thrashing.
+std::list<std::unique_ptr<RandomXContext>> g_randomx_contexts GUARDED_BY(g_randomx_mutex);
+constexpr size_t MAX_RANDOMX_CONTEXTS{2};
+} // namespace
+
+uint256 CoinSeriesCommitHash(const CBlockHeader& header)
+{
+    HashWriter hw{};
+    hw.write(std::as_bytes(std::span{COMMIT_TAG.data(), COMMIT_TAG.size()}));
+    hw << header.nVersion << header.hashPrevBlock << header.hashMerkleRoot << header.nTime << header.nBits;
+    return hw.GetHash();
+}
+
+uint256 CoinSeriesMergeRoot(const uint256& leaf, int slot, const std::array<uint256, 3>& branch)
+{
+    uint256 node = leaf;
+    for (int level = 0; level < 3; ++level) {
+        if ((slot >> level) & 1) {
+            node = Hash(branch[level], node);
+        } else {
+            node = Hash(node, branch[level]);
+        }
+    }
+    return node;
+}
+
+uint256 CoinSeriesMergeRootFromLeaves(const std::array<uint256, COIN_SERIES_MERGE_LEAVES>& leaves)
+{
+    std::array<uint256, 4> l1;
+    for (int i = 0; i < 4; ++i) l1[i] = Hash(leaves[2 * i], leaves[2 * i + 1]);
+    const uint256 a = Hash(l1[0], l1[1]);
+    const uint256 b = Hash(l1[2], l1[3]);
+    return Hash(a, b);
+}
+
+std::array<uint256, 3> CoinSeriesMergeBranch(const std::array<uint256, COIN_SERIES_MERGE_LEAVES>& leaves, int slot)
+{
+    std::array<uint256, 4> l1;
+    for (int i = 0; i < 4; ++i) l1[i] = Hash(leaves[2 * i], leaves[2 * i + 1]);
+    std::array<uint256, 2> l2{Hash(l1[0], l1[1]), Hash(l1[2], l1[3])};
+    return {leaves[slot ^ 1], l1[(slot >> 1) ^ 1], l2[(slot >> 2) ^ 1]};
+}
+
+uint256 CoinSeriesRandomXKey(uint32_t time)
+{
+    const uint64_t epoch = uint64_t{time} / COIN_SERIES_RANDOMX_EPOCH_SECONDS;
+    unsigned char epoch_le[8];
+    WriteLE64(epoch_le, epoch);
+    uint256 key;
+    CSHA256().Write(reinterpret_cast<const unsigned char*>(KEY_TAG.data()), KEY_TAG.size()).Write(epoch_le, sizeof(epoch_le)).Finalize(key.begin());
+    return key;
+}
+
+uint256 CoinSeriesRandomXHash(int version, const uint256& key, const uint256& root, uint64_t nonce)
+{
+    unsigned char input[40];
+    std::copy(root.begin(), root.end(), input);
+    WriteLE64(input + 32, nonce);
+    uint256 result;
+
+    LOCK(g_randomx_mutex);
+    auto it = g_randomx_contexts.begin();
+    for (; it != g_randomx_contexts.end(); ++it) {
+        if ((*it)->version == version && (*it)->key == key) break;
+    }
+    if (it == g_randomx_contexts.end()) {
+        g_randomx_contexts.push_front(std::make_unique<RandomXContext>(version, key));
+        while (g_randomx_contexts.size() > MAX_RANDOMX_CONTEXTS) g_randomx_contexts.pop_back();
+    } else if (it != g_randomx_contexts.begin()) {
+        g_randomx_contexts.splice(g_randomx_contexts.begin(), g_randomx_contexts, it);
+    }
+    randomx_calculate_hash(g_randomx_contexts.front()->vm, input, sizeof(input), result.begin());
+    return result;
+}
+
+uint256 CoinSeriesPowHash(const CBlockHeader& header, const Consensus::Params& params)
+{
+    const uint256 root = CoinSeriesMergeRoot(CoinSeriesCommitHash(header), params.nMergeSlot, header.vMergeBranch);
+    return CoinSeriesRandomXHash(params.nRandomXVersion, CoinSeriesRandomXKey(header.nTime), root, header.nNonce64);
+}
+
+bool CheckCoinSeriesProofOfWork(const CBlockHeader& header, const Consensus::Params& params)
+{
+    if (params.nMergeSlot < 0 || params.nMergeSlot >= COIN_SERIES_MERGE_LEAVES) return false;
+    const auto target{DeriveTarget(header.nBits, params.powLimit)};
+    if (!target) return false;
+    return UintToArith256(CoinSeriesPowHash(header, params)) <= *target;
+}
