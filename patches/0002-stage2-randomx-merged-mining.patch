+bool CheckProofOfWork(const CBlockHeader& header, const Consensus::Params& params)
+{
+    if (params.nMergeSlot < 0) return CheckProofOfWork(header.GetHash(), header.nBits, params);
+    if (header.hashPrevBlock.IsNull() && header.GetHash() == params.hashGenesisBlock) return true;
+    if (EnableFuzzDeterminism()) return DeriveTarget(header.nBits, params.powLimit).has_value();
+    return CheckCoinSeriesProofOfWork(header, params);
