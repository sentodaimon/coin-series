+// ---------------------------------------------------------------------------
+// Coin Series merged mining.
+//
+// A merged miner asks each of the five nodes for work (getmergework), builds the 8-leaf merge
+// tree from the five commitments, runs RandomX on root || nonce64 and, for every chain whose
+// target is met, returns that chain's three sibling hashes and the nonce (submitmergework).
+// The node keeps the full block for each piece of work it handed out.
+// ---------------------------------------------------------------------------
+namespace {
+Mutex g_merge_work_mutex;
+std::map<uint256, std::shared_ptr<CBlock>> g_merge_work GUARDED_BY(g_merge_work_mutex);
+std::deque<uint256> g_merge_work_order GUARDED_BY(g_merge_work_mutex);
+constexpr size_t MAX_MERGE_WORK{256};
+} // namespace
+
+static RPCHelpMan getmergework()
+{
+    return RPCHelpMan{"getmergework",
+        "Coin Series: create a block for merged mining and return its commitment.\n"
+        "Use the same time for all five chains so that they share one RandomX key.",
+        {
+            {"address", RPCArg::Type::STR, RPCArg::Optional::NO, "Address that receives the block reward."},
+            {"time", RPCArg::Type::NUM, RPCArg::DefaultHint{"current time"}, "Header time (seconds since epoch)."},
+        },
+        RPCResult{
+            RPCResult::Type::OBJ, "", "",
+            {
+                {RPCResult::Type::STR_HEX, "commitment", "commitment hash of the 76-byte header body (merge tree leaf)"},
+                {RPCResult::Type::NUM, "slot", "merge tree slot of this chain (0..4)"},
+                {RPCResult::Type::STR_HEX, "target", "proof-of-work target this chain requires"},
+                {RPCResult::Type::STR_HEX, "bits", "compact target"},
+                {RPCResult::Type::NUM, "time", "header time"},
+                {RPCResult::Type::NUM, "height", "height of the new block"},
+                {RPCResult::Type::NUM, "randomxversion", "RandomX version (1 or 2)"},
+                {RPCResult::Type::STR_HEX, "randomxkey", "RandomX key for this header time"},
+            }},
+        RPCExamples{HelpExampleCli("getmergework", "\"myaddress\"")},
+        [&](const RPCHelpMan& self, const JSONRPCRequest& request) -> UniValue
+{
+    NodeContext& node = EnsureAnyNodeContext(request.context);
+    Mining& miner = EnsureMining(node);
+    ChainstateManager& chainman = EnsureChainman(node);
+    const auto& consensus = chainman.GetConsensus();
+    if (consensus.nMergeSlot < 0) throw JSONRPCError(RPC_METHOD_NOT_FOUND, "getmergework is only available on Coin Series chains");
+
+    const CTxDestination destination = DecodeDestination(request.params[0].get_str());
+    if (!IsValidDestination(destination)) throw JSONRPCError(RPC_INVALID_ADDRESS_OR_KEY, "Error: Invalid address");
+
+    std::unique_ptr<BlockTemplate> block_template(miner.createNewBlock({.coinbase_output_script = GetScriptForDestination(destination), .include_dummy_extranonce = true}, /*cooldown=*/false));
+    CHECK_NONFATAL(block_template);
+    auto block = std::make_shared<CBlock>(block_template->getBlock());
+
+    int height;
+    {
+        LOCK(cs_main);
+        const CBlockIndex* prev = chainman.m_blockman.LookupBlockIndex(block->hashPrevBlock);
+        CHECK_NONFATAL(prev);
+        height = prev->nHeight + 1;
+        if (!request.params[1].isNull()) {
+            const int64_t t = request.params[1].getInt<int64_t>();
+            if (t <= prev->GetMedianTimePast()) throw JSONRPCError(RPC_INVALID_PARAMETER, "time must be later than the median time of the last 11 blocks");
+            if (t > GetTime() + MAX_FUTURE_BLOCK_TIME) throw JSONRPCError(RPC_INVALID_PARAMETER, "time is too far in the future");
+            block->nTime = static_cast<uint32_t>(t);
+            // The required target can depend on the header time (difficulty rules).
+            block->nBits = GetNextWorkRequired(prev, block.get(), consensus);
+        }
+    }
+    block->hashMerkleRoot = BlockMerkleRoot(*block);
+    const uint256 commitment = CoinSeriesCommitHash(*block);
+    {
+        LOCK(g_merge_work_mutex);
+        if (g_merge_work.emplace(commitment, block).second) g_merge_work_order.push_back(commitment);
+        while (g_merge_work_order.size() > MAX_MERGE_WORK) {
+            g_merge_work.erase(g_merge_work_order.front());
+            g_merge_work_order.pop_front();
+        }
+    }
+    UniValue result(UniValue::VOBJ);
+    result.pushKV("commitment", commitment.GetHex());
+    result.pushKV("slot", consensus.nMergeSlot);
+    result.pushKV("target", DeriveTarget(block->nBits, consensus.powLimit).value_or(arith_uint256{}).GetHex());
+    result.pushKV("bits", strprintf("%08x", block->nBits));
+    result.pushKV("time", block->nTime);
+    result.pushKV("height", height);
+    result.pushKV("randomxversion", consensus.nRandomXVersion);
+    result.pushKV("randomxkey", HexStr(CoinSeriesRandomXKey(block->nTime)));
+    return result;
+},
+    };
+}
+
+static RPCHelpMan submitmergework()
+{
+    return RPCHelpMan{"submitmergework",
+        "Coin Series: submit a merged-mining solution for work obtained with getmergework.",
+        {
+            {"commitment", RPCArg::Type::STR_HEX, RPCArg::Optional::NO, "commitment returned by getmergework"},
+            {"branch", RPCArg::Type::ARR, RPCArg::Optional::NO, "the three merge tree sibling hashes, leaf level first",
+                {{"hash", RPCArg::Type::STR_HEX, RPCArg::Optional::OMITTED, ""}}},
+            {"nonce", RPCArg::Type::STR, RPCArg::Optional::NO, "64-bit nonce as a decimal string"},
+        },
+        RPCResult{RPCResult::Type::OBJ, "", "",
+            {
+                {RPCResult::Type::BOOL, "accepted", "whether the block was accepted"},
+                {RPCResult::Type::STR_HEX, "hash", "block hash"},
+                {RPCResult::Type::STR, "reason", /*optional=*/true, "reason if not accepted"},
+            }},
+        RPCExamples{HelpExampleCli("submitmergework", "\"commitment\" '[\"h1\",\"h2\",\"h3\"]' \"12345\"")},
+        [&](const RPCHelpMan& self, const JSONRPCRequest& request) -> UniValue
+{
+    NodeContext& node = EnsureAnyNodeContext(request.context);
+    ChainstateManager& chainman = EnsureChainman(node);
+    const auto& consensus = chainman.GetConsensus();
+    if (consensus.nMergeSlot < 0) throw JSONRPCError(RPC_METHOD_NOT_FOUND, "submitmergework is only available on Coin Series chains");
+
+    const uint256 commitment = ParseHashV(request.params[0], "commitment");
+    const UniValue& branch = request.params[1].get_array();
+    if (branch.size() != 3) throw JSONRPCError(RPC_INVALID_PARAMETER, "branch must contain exactly 3 hashes");
+    const auto nonce = ToIntegral<uint64_t>(request.params[2].get_str());
+    if (!nonce) throw JSONRPCError(RPC_INVALID_PARAMETER, "invalid nonce");
+
+    std::shared_ptr<CBlock> block;
+    {
+        LOCK(g_merge_work_mutex);
+        auto it = g_merge_work.find(commitment);
+        if (it == g_merge_work.end()) throw JSONRPCError(RPC_INVALID_PARAMETER, "unknown or expired work");
+        block = std::make_shared<CBlock>(*it->second);
+    }
+    for (int i = 0; i < 3; ++i) block->vMergeBranch[i] = ParseHashV(branch[i], "branch");
+    block->nNonce64 = *nonce;
+
+    UniValue result(UniValue::VOBJ);
+    result.pushKV("hash", block->GetHash().GetHex());
+    if (!CheckProofOfWork(static_cast<const CBlockHeader&>(*block), consensus)) {
+        result.pushKV("accepted", false);
+        result.pushKV("reason", "proof of work does not meet this chain's target");
+        return result;
+    }
+    bool new_block{false};
+    const bool accepted = chainman.ProcessNewBlock(block, /*force_processing=*/true, /*min_pow_checked=*/true, &new_block);
+    result.pushKV("accepted", accepted && new_block);
+    if (!accepted) result.pushKV("reason", "block rejected");
+    else if (!new_block) result.pushKV("reason", "duplicate");
+    return result;
+},
+    };
+}
