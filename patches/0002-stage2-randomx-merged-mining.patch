+// Header format: 76-byte body + 3 x 32-byte merge siblings + 8-byte nonce = 180 bytes.
+BOOST_AUTO_TEST_CASE(header_format)
+{
+    CBlockHeader h;
+    h.nVersion = 4;
+    h.nTime = 1790812800;
+    h.nBits = 0x207fffff;
+    h.vMergeBranch = {uint256::ONE, uint256{2}, uint256{3}};
+    h.nNonce64 = 0x0123456789abcdefULL;
+    {
+        CoinSeriesHeaderScope on{true};
+        DataStream ds{};
+        ds << h;
+        BOOST_CHECK_EQUAL(ds.size(), 180U);
+        CBlockHeader back;
+        ds >> back;
+        BOOST_CHECK(back.GetHash() == h.GetHash());
+        BOOST_CHECK(back.vMergeBranch == h.vMergeBranch);
+        BOOST_CHECK_EQUAL(back.nNonce64, h.nNonce64);
+    }
+    DataStream ds{};
+    ds << h;
+    BOOST_CHECK_EQUAL(ds.size(), 80U); // original Bitcoin format unchanged
+}
+
+// Merge tree: the branch for each slot rebuilds the same root as the full tree.
+BOOST_AUTO_TEST_CASE(merge_tree)
+{
+    std::array<uint256, COIN_SERIES_MERGE_LEAVES> leaves{};
+    for (int i = 0; i < 5; ++i) leaves[i] = Hash(std::vector<unsigned char>{(unsigned char)i});
+    const uint256 root = CoinSeriesMergeRootFromLeaves(leaves);
+    for (int slot = 0; slot < COIN_SERIES_MERGE_LEAVES; ++slot) {
+        const auto branch = CoinSeriesMergeBranch(leaves, slot);
+        BOOST_CHECK(CoinSeriesMergeRoot(leaves[slot], slot, branch) == root);
+        // A chain's commitment placed in a different slot gives a different root
+        // (checked for the five used slots; unused slots are all zero and interchangeable).
+        if (slot < 5) BOOST_CHECK(CoinSeriesMergeRoot(leaves[slot], slot ^ 1, branch) != root);
+    }
+}
+
+// RandomX key changes every 2 weeks and depends only on the header time.
+BOOST_AUTO_TEST_CASE(randomx_key_epochs)
+{
+    const uint32_t t0 = 1209600 * 1480;
+    BOOST_CHECK(CoinSeriesRandomXKey(t0) == CoinSeriesRandomXKey(t0 + 1209599));
+    BOOST_CHECK(CoinSeriesRandomXKey(t0) != CoinSeriesRandomXKey(t0 + 1209600));
+    BOOST_CHECK(CoinSeriesRandomXKey(t0) != CoinSeriesRandomXKey(t0 - 1));
+}
+
+// Proof of work: a solved header is accepted only for its own slot and only unmodified.
+BOOST_AUTO_TEST_CASE(randomx_proof_of_work)
+{
+    CoinSeriesHeaderScope on{true};
+    for (int version : {1, 2}) {
+        auto half = CChainParams::CoinSeries(CoinSeriesId::HALF, ChainType::REGTEST, {}, version);
+        auto cent = CChainParams::CoinSeries(CoinSeriesId::CENT, ChainType::REGTEST, {}, version);
+        Consensus::Params c = half->GetConsensus();
+        c.powLimit = uint256{"00ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"}; // ~1 in 256 hashes
+
+        CBlockHeader h;
+        h.nVersion = 0x20000000;
+        h.hashPrevBlock = uint256::ONE;
+        h.hashMerkleRoot = uint256{7};
+        h.nTime = 1790812800;
+        h.nBits = UintToArith256(c.powLimit).GetCompact();
+        std::array<uint256, COIN_SERIES_MERGE_LEAVES> leaves{};
+        leaves[c.nMergeSlot] = CoinSeriesCommitHash(h);
+        leaves[4] = uint256{99}; // some other chain's commitment in the Cent slot
+        h.vMergeBranch = CoinSeriesMergeBranch(leaves, c.nMergeSlot);
+        int tries = 0;
+        while (!CheckProofOfWork(h, c) && tries < 20000) { ++h.nNonce64; ++tries; }
+        BOOST_REQUIRE(CheckProofOfWork(h, c));
+        BOOST_TEST_MESSAGE("RandomX v" << version << ": solved after " << tries + 1 << " hashes");
+        // Deterministic: the proof-of-work hash is reproducible.
+        BOOST_CHECK(CoinSeriesPowHash(h, c) == CoinSeriesPowHash(h, c));
+
+        // The same header is not valid for another chain (different slot).
+        Consensus::Params cc = cent->GetConsensus();
+        cc.powLimit = c.powLimit;
+        BOOST_CHECK(CoinSeriesPowHash(h, cc) != CoinSeriesPowHash(h, c));
+
+        // Changing any committed field changes the proof-of-work hash.
+        CBlockHeader t = h; t.nTime += 1;
+        BOOST_CHECK(CoinSeriesPowHash(t, c) != CoinSeriesPowHash(h, c));
+        t = h; t.hashMerkleRoot = uint256{8};
+        BOOST_CHECK(CoinSeriesPowHash(t, c) != CoinSeriesPowHash(h, c));
+        t = h; t.vMergeBranch[2] = uint256{5};
+        BOOST_CHECK(CoinSeriesPowHash(t, c) != CoinSeriesPowHash(h, c));
+        t = h; t.nNonce64 += 1;
+        BOOST_CHECK(CoinSeriesPowHash(t, c) != CoinSeriesPowHash(h, c));
+        // A target above the limit is rejected.
+        t = h; t.nBits = 0x207fffff;
+        BOOST_CHECK(!CheckProofOfWork(t, c));
+    }
+    // RandomX v1 and v2 give different hashes for the same input.
+    const uint256 key = CoinSeriesRandomXKey(1790812800);
+    BOOST_CHECK(CoinSeriesRandomXHash(1, key, uint256::ONE, 0) != CoinSeriesRandomXHash(2, key, uint256::ONE, 0));
+}
+
 BOOST_AUTO_TEST_SUITE_END()
