+++ b/contrib/coinseries/merge_miner.py
@@ -0,0 +1,212 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 Sento Daimon
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""
+Coin Series merged miner (reference implementation).
+
+One RandomX computation mines all five chains at once:
+  1. ask each node for work with the same header time (getmergework)
+  2. build the 8-leaf merge tree from the commitments (slot = chain's merge slot)
+  3. RandomX(key, root || nonce64) for increasing nonces
+  4. for every chain whose target is met, submit that chain's 3 sibling hashes and the nonce
+
+Requires the RandomX shared library (librandomx.so / randomx.dll) built from src/randomx.
+
+Example:
+  merge_miner.py --lib build-randomx/librandomx.so --datadir ~/.bitcoin --chain regtest \
+      --coin half=ADDR --coin quarter=ADDR --coin dime=ADDR --coin nickel=ADDR --coin cent=ADDR
+"""
+import argparse
+import base64
+import ctypes
+import hashlib
+import json
+import os
+import struct
+import sys
+import time
+import urllib.request
+
+COINS = {  # name: (merge slot, main RPC port)
+    "half": (0, 38202), "quarter": (1, 38204), "dime": (2, 38210), "nickel": (3, 38220), "cent": (4, 38300),
+}
+ENV_OFFSET = {"main": 0, "test": 10000, "regtest": 20000}
+ENV_DIR = {"main": "", "test": "-testnet", "regtest": "-regtest"}
+RANDOMX_FLAG_DEFAULT = 0
+RANDOMX_FLAG_FULL_MEM = 4
+RANDOMX_FLAG_V2 = 128
+
+
+def sha256d(b):
+    return hashlib.sha256(hashlib.sha256(b).digest()).digest()
+
+
+def merge_tree(leaves):
+    """Return (root, branches[slot]) for 8 leaves of 32 bytes (internal byte order)."""
+    l1 = [sha256d(leaves[2 * i] + leaves[2 * i + 1]) for i in range(4)]
+    l2 = [sha256d(l1[0] + l1[1]), sha256d(l1[2] + l1[3])]
+    root = sha256d(l2[0] + l2[1])
+    branches = [[leaves[s ^ 1], l1[(s >> 1) ^ 1], l2[(s >> 2) ^ 1]] for s in range(8)]
+    return root, branches
+
+
+def merge_root_from_branch(leaf, slot, branch):
+    node = leaf
+    for level in range(3):
+        node = sha256d(branch[level] + node) if (slot >> level) & 1 else sha256d(node + branch[level])
+    return node
+
+
+class RandomX:
+    def __init__(self, lib_path, fast=False):
+        self.lib = ctypes.CDLL(lib_path)
+        L = self.lib
+        L.randomx_get_flags.restype = ctypes.c_int
+        L.randomx_alloc_cache.restype = ctypes.c_void_p
+        L.randomx_alloc_cache.argtypes = [ctypes.c_int]
+        L.randomx_init_cache.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_size_t]
+        L.randomx_release_cache.argtypes = [ctypes.c_void_p]
+        L.randomx_alloc_dataset.restype = ctypes.c_void_p
+        L.randomx_alloc_dataset.argtypes = [ctypes.c_int]
+        L.randomx_dataset_item_count.restype = ctypes.c_ulong
+        L.randomx_init_dataset.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong]
+        L.randomx_release_dataset.argtypes = [ctypes.c_void_p]
+        L.randomx_create_vm.restype = ctypes.c_void_p
+        L.randomx_create_vm.argtypes = [ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p]
+        L.randomx_destroy_vm.argtypes = [ctypes.c_void_p]
+        L.randomx_calculate_hash.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_size_t, ctypes.c_char_p]
+        self.fast = fast
+        self.key = None
+        self.version = None
+        self.cache = self.dataset = self.vm = None
+
+    def set_key(self, key, version):
+        if key == self.key and version == self.version:
+            return
+        self.release()
+        L = self.lib
+        flags = L.randomx_get_flags() | (RANDOMX_FLAG_V2 if version == 2 else 0)
+        self.cache = L.randomx_alloc_cache(flags)
+        L.randomx_init_cache(self.cache, key, len(key))
+        if self.fast:
+            self.dataset = L.randomx_alloc_dataset(flags)
+            L.randomx_init_dataset(self.dataset, self.cache, 0, L.randomx_dataset_item_count())
+            self.vm = L.randomx_create_vm(flags | RANDOMX_FLAG_FULL_MEM, None, self.dataset)
+        else:
+            self.vm = L.randomx_create_vm(flags, self.cache, None)
+        if not self.vm:
+            raise RuntimeError("cannot create RandomX virtual machine")
+        self.key, self.version = key, version
+
+    def hash(self, data):
+        out = ctypes.create_string_buffer(32)
+        self.lib.randomx_calculate_hash(self.vm, data, len(data), out)
+        return out.raw
+
+    def release(self):
+        L = self.lib
+        if self.vm: L.randomx_destroy_vm(self.vm)
+        if self.dataset: L.randomx_release_dataset(self.dataset)
+        if self.cache: L.randomx_release_cache(self.cache)
+        self.vm = self.dataset = self.cache = None
+
+
+class Node:
+    def __init__(self, coin, chain, datadir, host, rpcuser=None, rpcpassword=None):
+        self.coin = coin
+        self.slot, port = COINS[coin]
+        self.url = f"http://{host}:{port + ENV_OFFSET[chain]}/"
+        if rpcuser:
+            self.auth = f"{rpcuser}:{rpcpassword}"
+        else:
+            cookie = os.path.join(os.path.expanduser(datadir), coin + ENV_DIR[chain], ".cookie")
+            with open(cookie) as f:
+                self.auth = f.read().strip()
+
+    def call(self, method, *params):
+        body = json.dumps({"jsonrpc": "1.0", "id": "mm", "method": method, "params": list(params)}).encode()
+        req = urllib.request.Request(self.url, data=body, headers={
+            "Authorization": "Basic " + base64.b64encode(self.auth.encode()).decode(),
+            "Content-Type": "application/json"})
+        with urllib.request.urlopen(req, timeout=60) as r:
+            res = json.loads(r.read())
+        if res.get("error"):
+            raise RuntimeError(f"{self.coin} {method}: {res['error']}")
+        return res["result"]
+
+
+def mine(args):
+    rx = RandomX(args.lib, fast=args.fast)
+    nodes = []
+    for spec in args.coin:
+        name, addr = spec.split("=", 1)
+        nodes.append((Node(name, args.chain, args.datadir, args.host, args.rpcuser, args.rpcpassword), addr))
+    found_total = {n.coin: 0 for n, _ in nodes}
+    start = time.time()
+    hashes = 0
+    while args.blocks <= 0 or min(found_total.values()) < args.blocks:
+        t = int(time.time())
+        work = {}
+        for node, addr in nodes:
+            try:
+                w = node.call("getmergework", addr, t)
+            except RuntimeError as e:  # e.g. time not after median time past on a fast regtest chain
+                w = node.call("getmergework", addr)
+            work[node.coin] = (node, w)
+        keys = {w["randomxkey"] for _, w in work.values()}
+        versions = {w["randomxversion"] for _, w in work.values()}
+        if len(keys) != 1 or len(versions) != 1:
+            # Only chains that share one key can be mined together; take the most common key.
+            key = max(keys, key=lambda k: sum(1 for _, w in work.values() if w["randomxkey"] == k))
+            work = {c: v for c, v in work.items() if v[1]["randomxkey"] == key}
+        first = next(iter(work.values()))[1]
+        rx.set_key(bytes.fromhex(first["randomxkey"]), first["randomxversion"])
+
+        leaves = [bytes(32)] * 8
+        targets = {}
+        for coin, (node, w) in work.items():
+            leaves[w["slot"]] = bytes.fromhex(w["commitment"])[::-1]
+            targets[coin] = int(w["target"], 16)
+        root, branches = merge_tree(leaves)
+        pending = set(work)
+        deadline = time.time() + args.refresh
+        nonce = int.from_bytes(os.urandom(4), "little") << 24
+        while pending and time.time() < deadline:
+            h = rx.hash(root + struct.pack("<Q", nonce))
+            hashes += 1
+            value = int.from_bytes(h, "little")
+            for coin in list(pending):
+                if value <= targets[coin]:
+                    node, w = work[coin]
+                    br = [b[::-1].hex() for b in branches[w["slot"]]]
+                    res = node.call("submitmergework", w["commitment"], br, str(nonce))
+                    status = "accepted" if res.get("accepted") else f"rejected ({res.get('reason')})"
+                    print(f"[{time.strftime('%H:%M:%S')}] {coin:8s} height {w['height']:>6} nonce {nonce} {status}", flush=True)
+                    if res.get("accepted"):
+                        found_total[coin] += 1
+                    pending.discard(coin)
+            nonce += 1
+        # Refresh work after any block (other chains' commitments change only for chains that advanced,
+        # but a fresh common time keeps all five on one key).
+    elapsed = time.time() - start
+    print(f"done: {hashes} hashes in {elapsed:.1f}s ({hashes / max(elapsed, 1e-9):.1f} H/s); blocks: {found_total}")
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument("--lib", required=True, help="path to librandomx shared library")
+    p.add_argument("--chain", default="main", choices=["main", "test", "regtest"])
+    p.add_argument("--datadir", default="~/.bitcoin", help="node base data directory (for .cookie files)")
+    p.add_argument("--host", default="127.0.0.1")
+    p.add_argument("--rpcuser")
+    p.add_argument("--rpcpassword")
+    p.add_argument("--coin", action="append", required=True, help="name=reward_address, repeat per chain")
+    p.add_argument("--fast", action="store_true", help="RandomX fast mode (2 GiB dataset, much faster hashing)")
+    p.add_argument("--refresh", type=float, default=30.0, help="seconds before fetching fresh work")
+    p.add_argument("--blocks", type=int, default=0, help="stop after every chain has this many new blocks (0 = run forever)")
+    mine(p.parse_args())
+
+
+if __name__ == "__main__":
+    main()
