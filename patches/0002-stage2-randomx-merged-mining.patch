+
+bool CheckStoredProofOfWork(uint256 hash, unsigned int nBits, const Consensus::Params& params)
+{
+    if (params.nMergeSlot < 0) return CheckProofOfWork(hash, nBits, params);
+    if (hash == params.hashGenesisBlock) return true;
+    return DeriveTarget(nBits, params.powLimit).has_value();
+}
