+// ---- Difficulty: ASERT anchored at height 1 + stall relief ----
+namespace {
+struct TestChain {
+    std::deque<CBlockIndex> blocks;
+    std::deque<uint256> hashes;
+    explicit TestChain(uint32_t genesis_time, uint32_t genesis_bits)
+    {
+        Add(genesis_time, genesis_bits);
+    }
+    const CBlockIndex* Add(uint32_t time, uint32_t bits)
+    {
+        CBlockIndex& b = blocks.emplace_back();
+        hashes.emplace_back(uint256{static_cast<uint8_t>(blocks.size())});
+        b.phashBlock = &hashes.back();
+        b.nTime = time;
+        b.nBits = bits;
+        b.nHeight = blocks.size() - 1;
+        b.pprev = blocks.size() > 1 ? &blocks[blocks.size() - 2] : nullptr;
+        b.BuildSkip();
+        return &b;
+    }
+    const CBlockIndex* Tip() const { return &blocks.back(); }
+};
+double Ratio(uint32_t bits, uint32_t start_bits)
+{
+    arith_uint256 a, b;
+    a.SetCompact(bits);
+    b.SetCompact(start_bits);
+    return a.getdouble() / b.getdouble();
+}
+uint32_t Next(const TestChain& c, uint32_t new_time, const Consensus::Params& p)
+{
+    CBlockHeader h;
+    h.nTime = new_time;
+    return GetNextWorkRequired(c.Tip(), &h, p);
+}
+} // namespace
+
+BOOST_AUTO_TEST_CASE(asert_vectors)
+{
+    auto params = Make(CoinSeriesId::DIME, ChainType::MAIN);
+    const auto& p = params->GetConsensus();
+    BOOST_REQUIRE_EQUAL(p.nASERTHalfLife, 7200);
+    const uint32_t t0 = params->GenesisBlock().nTime;
+    TestChain c{t0, params->GenesisBlock().nBits};
+
+    // Height 1 (anchor) uses the start target, even long after genesis (no relief at height 1).
+    BOOST_CHECK_EQUAL(Next(c, t0 + 600, p), p.nASERTStartBits);
+    BOOST_CHECK_EQUAL(Next(c, t0 + 30 * 86400, p), p.nASERTStartBits);
+    c.Add(t0 + 600, p.nASERTStartBits);
+
+    // Height 2 when height 1 came exactly on schedule: start target exactly (fixes the earlier 0.9976 off-by-one).
+    BOOST_CHECK_EQUAL(Next(c, t0 + 1200, p), p.nASERTStartBits);
+
+    // Steady 10-minute blocks keep the start target.
+    for (int h = 2; h <= 500; ++h) {
+        const uint32_t bits = Next(c, t0 + 600 * h, p);
+        BOOST_CHECK_EQUAL(bits, p.nASERTStartBits);
+        c.Add(t0 + 600 * h, bits);
+    }
+
+    // One half-life behind schedule: target x2. One half-life ahead: target / 2.
+    {
+        TestChain d{t0, params->GenesisBlock().nBits};
+        d.Add(t0 + 600 + 7200, p.nASERTStartBits);
+        BOOST_CHECK_CLOSE(Ratio(Next(d, t0 + 600 + 7200 + 600, p), p.nASERTStartBits), 2.0, 0.1);
+        TestChain e{t0, params->GenesisBlock().nBits};
+        e.Add(t0 + 600, p.nASERTStartBits);
+        for (int h = 2; h <= 13; ++h) e.Add(t0 + 600, p.nASERTStartBits); // 12 blocks with no time passing = 7200s ahead
+        BOOST_CHECK_CLOSE(Ratio(Next(e, t0 + 601, p), p.nASERTStartBits), 0.5, 0.1);
+    }
+
+    // Stall relief: none up to 1 hour, x2 at 1.5 hours, x1024 at 6 hours (5 hours of excess / 30 minutes).
+    const uint32_t tip_time = c.Tip()->nTime;
+    const uint32_t base = Next(c, tip_time + 600, p);
+    BOOST_CHECK_EQUAL(Next(c, tip_time + 3600, p), base);
+    BOOST_CHECK_CLOSE(Ratio(Next(c, tip_time + 5400, p), base), 2.0, 0.1);
+    BOOST_CHECK_CLOSE(Ratio(Next(c, tip_time + 6 * 3600, p), base), 1024.0, 0.1);
+    // Moving the time 10 minutes forward inside the relief zone eases the target about 1.26x (bounded by the future limit).
+    BOOST_CHECK_CLOSE(Ratio(Next(c, tip_time + 7200 + 600, p), Next(c, tip_time + 7200, p)), std::pow(2.0, 600.0 / 1800), 0.1);
+    BOOST_CHECK_EQUAL(p.nMaxFutureBlockTime, 600);
+    // Never easier than the limit.
+    arith_uint256 lim = UintToArith256(p.powLimit);
+    arith_uint256 got;
+    got.SetCompact(Next(c, tip_time + 30 * 86400, p));
+    BOOST_CHECK(got <= lim);
+    BOOST_CHECK_EQUAL(Next(c, tip_time + 30 * 86400, p), lim.GetCompact());
+
+    // Original Bitcoin rules are untouched.
+    auto btc = CreateChainParams(ArgsManager{}, ChainType::MAIN);
+    BOOST_CHECK_EQUAL(btc->GetConsensus().nASERTHalfLife, 0);
+}
+
+// The integer evaluation matches 2^x closely across the range (aserti3-2d approximation error < 0.013%).
+BOOST_AUTO_TEST_CASE(asert_exponent_accuracy)
+{
+    const arith_uint256 ref = UintToArith256(uint256{"00001bf647000000000000000000000000000000000000000000000000000000"});
+    const arith_uint256 lim = ~arith_uint256{0} >> 1;
+    for (int64_t e = -20 * 65536; e <= 15 * 65536; e += 4099) { // stays below the clamp limit
+        const double expected = ref.getdouble() * std::pow(2.0, double(e) / 65536.0);
+        const double got = CoinSeriesApplyExponent(ref, e, lim).getdouble();
+        BOOST_CHECK_CLOSE(got, expected, 0.02);
+    }
+}
+
+// Simulation with the real difficulty function: 1000x hash power for 48 hours, then it leaves.
+// Reports and checks the time to the first block after the exit (decided goal: within about 6 hours).
+BOOST_AUTO_TEST_CASE(asert_stall_simulation)
+{
+    auto params = Make(CoinSeriesId::HALF, ChainType::MAIN);
+    const auto& p = params->GetConsensus();
+    arith_uint256 start;
+    start.SetCompact(p.nASERTStartBits);
+    const double base_rate = (std::pow(2.0, 256) / start.getdouble()) / 600.0; // hashes/s giving 10-minute blocks
+    FastRandomContext rng{uint256{42}};
+
+    std::vector<double> first_after_exit, recover, inflow_blocks;
+    for (int run = 0; run < 30; ++run) {
+        const uint32_t t0 = params->GenesisBlock().nTime;
+        TestChain c{t0, params->GenesisBlock().nBits};
+        uint32_t now = t0;
+        const uint32_t inflow_start = t0 + 2 * 86400, inflow_end = inflow_start + 48 * 3600;
+        int blocks_in_inflow = 0;
+        uint32_t first_exit_block = 0, recovered_at = 0;
+        std::deque<uint32_t> recent;
+        while (now < inflow_end + 20 * 86400) {
+            now += 30; // 30-second steps
+            const double rate = base_rate * ((now >= inflow_start && now < inflow_end) ? 1000.0 : 1.0);
+            const uint32_t bits = Next(c, now, p);
+            arith_uint256 tgt;
+            tgt.SetCompact(bits);
+            const double work = std::pow(2.0, 256) / tgt.getdouble();
+            const double prob = 1.0 - std::exp(-rate * 30.0 / work);
+            if (rng.randrange(1u << 30) < prob * double(1u << 30)) {
+                c.Add(now, bits);
+                if (now >= inflow_start && now < inflow_end) ++blocks_in_inflow;
+                if (now >= inflow_end) {
+                    if (!first_exit_block) first_exit_block = now;
+                    recent.push_back(now);
+                    if (recent.size() > 6) recent.pop_front();
+                    if (!recovered_at && recent.size() == 6 && (recent.back() - recent.front()) / 5.0 <= 900.0) recovered_at = now;
+                }
+            }
+            if (recovered_at) break;
+        }
+        first_after_exit.push_back((first_exit_block - inflow_end) / 3600.0);
+        recover.push_back(((recovered_at ? recovered_at : now) - inflow_end) / 3600.0);
+        inflow_blocks.push_back(blocks_in_inflow);
+    }
+    auto median = [](std::vector<double> v) { std::sort(v.begin(), v.end()); return v[v.size() / 2]; };
+    auto pct = [](std::vector<double> v, double q) { std::sort(v.begin(), v.end()); return v[std::min<size_t>(v.size() - 1, size_t(q * v.size()))]; };
+    BOOST_TEST_MESSAGE("1000x for 48h then exit (30 runs): first block after exit median " << median(first_after_exit)
+        << "h, 90th pct " << pct(first_after_exit, 0.9) << "h; back to <=15 min average (6 blocks) median "
+        << median(recover) << "h; blocks during inflow median " << median(inflow_blocks) << " (normal 288)");
+    BOOST_CHECK(median(first_after_exit) <= 6.5);
+    BOOST_CHECK(median(recover) <= 48.0);
+}
