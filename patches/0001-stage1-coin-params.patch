+// Copyright (c) 2026 Sento Daimon
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <addresstype.h>
+#include <base58.h>
+#include <arith_uint256.h>
+#include <chainparams.h>
+#include <chainparamsbase.h>
+#include <common/args.h>
+#include <consensus/amount.h>
+#include <key.h>
+#include <key_io.h>
+#include <kernel/coinseries.h>
+#include <pow.h>
+#include <script/script.h>
+#include <util/chaintype.h>
+#include <validation.h>
+
+#include <test/util/setup_common.h>
+
+#include <boost/test/unit_test.hpp>
+
+#include <set>
+#include <string>
+
+BOOST_FIXTURE_TEST_SUITE(coinseries_tests, BasicTestingSetup)
+
+static const std::array<ChainType, 3> ENVS{ChainType::MAIN, ChainType::TESTNET, ChainType::REGTEST};
+
+static std::unique_ptr<const CChainParams> Make(CoinSeriesId coin, ChainType chain)
+{
+    return CChainParams::CoinSeries(coin, chain, CChainParams::RegTestOptions{});
+}
+
+BOOST_AUTO_TEST_CASE(coin_names)
+{
+    BOOST_CHECK(CoinFromString("") == CoinSeriesId::NONE);
+    BOOST_CHECK(CoinFromString("half") == CoinSeriesId::HALF);
+    BOOST_CHECK(CoinFromString("cent") == CoinSeriesId::CENT);
+    BOOST_CHECK(!CoinFromString("penny"));
+    BOOST_CHECK_THROW(Make(CoinSeriesId::HALF, ChainType::SIGNET), std::runtime_error);
+    BOOST_CHECK_THROW(Make(CoinSeriesId::HALF, ChainType::TESTNET4), std::runtime_error);
+}
+
+// Every coin/environment must have its own network magic, P2P port, RPC port, data directory,
+// address prefixes and genesis block, and none may collide with Bitcoin's networks.
+BOOST_AUTO_TEST_CASE(identifiers_are_unique)
+{
+    std::set<std::string> magics, hrps, dirs;
+    std::set<uint16_t> ports;
+    std::set<uint256> geneses;
+    std::set<uint32_t> sigids;
+    std::set<std::vector<unsigned char>> pubkey_prefixes, script_prefixes;
+
+    for (ChainType bitcoin_chain : {ChainType::MAIN, ChainType::TESTNET, ChainType::TESTNET4, ChainType::SIGNET, ChainType::REGTEST}) {
+        auto p = CreateChainParams(ArgsManager{}, bitcoin_chain);
+        const auto m = p->MessageStart();
+        magics.insert(std::string(m.begin(), m.end()));
+        ports.insert(p->GetDefaultPort());
+        ports.insert(CreateBaseChainParams(bitcoin_chain)->RPCPort());
+    }
+    const size_t bitcoin_magics = magics.size();
+    const size_t bitcoin_ports = ports.size();
+
+    for (const auto& info : COIN_TABLE) {
+        for (size_t e = 0; e < ENVS.size(); ++e) {
+            auto p = Make(info.coin, ENVS[e]);
+            auto base = CreateBaseChainParams(ENVS[e], info.coin);
+            const auto m = p->MessageStart();
+            magics.insert(std::string(m.begin(), m.end()));
+            BOOST_CHECK_EQUAL(p->GetDefaultPort(), info.p2p_port_main + 10000 * e);
+            BOOST_CHECK_EQUAL(base->RPCPort(), info.rpc_port_main + 10000 * e);
+            ports.insert(p->GetDefaultPort());
+            ports.insert(base->RPCPort());
+            hrps.insert(p->Bech32HRP());
+            dirs.insert(base->DataDir());
+            geneses.insert(p->GetConsensus().hashGenesisBlock);
+            sigids.insert(p->GetConsensus().nChainSigId);
+            pubkey_prefixes.insert(p->Base58Prefix(CChainParams::PUBKEY_ADDRESS));
+            script_prefixes.insert(p->Base58Prefix(CChainParams::SCRIPT_ADDRESS));
+            BOOST_CHECK_EQUAL(p->GetConsensus().nMergeSlot, info.merge_slot);
+            BOOST_CHECK_EQUAL(p->GetConsensus().nSupplyMultiplier, info.multiplier);
+            BOOST_CHECK_EQUAL(p->GetConsensus().nSnapshotHeight, 840000);
+            BOOST_CHECK(p->DNSSeeds().empty());
+            BOOST_CHECK(p->FixedSeeds().empty());
+            BOOST_CHECK(p->GetConsensus().nMinimumChainWork == uint256{});
+            BOOST_CHECK(p->GetConsensus().defaultAssumeValid == uint256{});
+        }
+    }
+    BOOST_CHECK_EQUAL(magics.size(), bitcoin_magics + 15);
+    BOOST_CHECK_EQUAL(ports.size(), bitcoin_ports + 30);
+    BOOST_CHECK_EQUAL(hrps.size(), 15U);
+    BOOST_CHECK_EQUAL(dirs.size(), 15U);
+    BOOST_CHECK_EQUAL(geneses.size(), 15U);
+    BOOST_CHECK_EQUAL(sigids.size(), 15U);
+    BOOST_CHECK_EQUAL(pubkey_prefixes.size(), 15U);
+    BOOST_CHECK_EQUAL(script_prefixes.size(), 15U);
+}
+
+BOOST_AUTO_TEST_CASE(genesis_is_valid)
+{
+    for (const auto& info : COIN_TABLE) {
+        for (ChainType env : ENVS) {
+            auto p = Make(info.coin, env);
+            const CBlock& g = p->GenesisBlock();
+            BOOST_CHECK(g.GetHash() == p->GetConsensus().hashGenesisBlock);
+            BOOST_CHECK(CheckProofOfWork(g.GetHash(), g.nBits, p->GetConsensus()));
+            BOOST_CHECK_EQUAL(g.vtx[0]->GetValueOut(), 0);
+            BOOST_CHECK_EQUAL(GetBlockSubsidy(0, p->GetConsensus()), 0);
+        }
+    }
+}
+
+// Decided reward rule: new-chain height h is rewarded as Bitcoin height 840000 + h, times the multiplier.
+BOOST_AUTO_TEST_CASE(block_subsidy)
+{
+    for (const auto& info : COIN_TABLE) {
+        auto p = Make(info.coin, ChainType::MAIN);
+        const auto& c = p->GetConsensus();
+        const CAmount m = info.multiplier;
+        BOOST_CHECK_EQUAL(GetBlockSubsidy(1, c), 3 * COIN * m + COIN * m / 8);           // 3.125 x m
+        BOOST_CHECK_EQUAL(GetBlockSubsidy(209999, c), 3 * COIN * m + COIN * m / 8);
+        BOOST_CHECK_EQUAL(GetBlockSubsidy(210000, c), (50 * COIN * m) >> 5);            // 1.5625 x m
+        BOOST_CHECK_EQUAL(GetBlockSubsidy(420000, c), (50 * COIN * m) >> 6);
+        BOOST_CHECK_EQUAL(GetBlockSubsidy(64 * 210000, c), 0);
+
+        // Total ever mined plus the nominal claimable amount must not exceed 21 million x multiplier.
+        CAmount mined = 0;
+        for (int era = 0; era < 64; ++era) {
+            const int first = era == 0 ? 1 : era * 210000;
+            const int last = (era + 1) * 210000 - 1;
+            mined += GetBlockSubsidy(first, c) * (last - first + 1);
+        }
+        const CAmount claimable = (19687500 * COIN + 3 * COIN + COIN / 8) * m;   // 19,687,503.125 x m
+        BOOST_CHECK(mined + claimable <= 21000000 * COIN * m);
+        BOOST_CHECK(mined + claimable <= COIN_SERIES_MAX_MONEY_CEILING);
+        BOOST_TEST_MESSAGE(info.name << ": mined " << mined << " + claimable " << claimable);
+    }
+    // Original Bitcoin schedule is unchanged when no coin is selected.
+    auto btc = CreateChainParams(ArgsManager{}, ChainType::MAIN);
+    BOOST_CHECK_EQUAL(GetBlockSubsidy(0, btc->GetConsensus()), 50 * COIN);
+    BOOST_CHECK_EQUAL(GetBlockSubsidy(840000, btc->GetConsensus()), 3 * COIN + COIN / 8);
+}
+
+// Addresses start with recognizable letters on mainnet and differ between chains.
+BOOST_AUTO_TEST_CASE(address_prefixes)
+{
+    CKey key = GenerateRandomKey();
+    const CPubKey pub = key.GetPubKey();
+    const std::map<CoinSeriesId, std::pair<char, char>> letters{
+        {CoinSeriesId::HALF, {'H', 'h'}}, {CoinSeriesId::QUARTER, {'Q', 'q'}}, {CoinSeriesId::DIME, {'D', 'd'}},
+        {CoinSeriesId::NICKEL, {'N', 'n'}}, {CoinSeriesId::CENT, {'C', 'c'}}};
+    for (const auto& info : COIN_TABLE) {
+        auto p = Make(info.coin, ChainType::MAIN);
+        const std::string pkh = EncodeBase58Check([&] {
+            std::vector<unsigned char> v = p->Base58Prefix(CChainParams::PUBKEY_ADDRESS);
+            const PKHash h{pub};
+            v.insert(v.end(), h.begin(), h.end());
+            return v;
+        }());
+        BOOST_CHECK_EQUAL(pkh[0], letters.at(info.coin).first);
+        const std::string sh = EncodeBase58Check([&] {
+            std::vector<unsigned char> v = p->Base58Prefix(CChainParams::SCRIPT_ADDRESS);
+            const ScriptHash h{CScript() << OP_TRUE};
+            v.insert(v.end(), h.begin(), h.end());
+            return v;
+        }());
+        BOOST_CHECK_EQUAL(sh[0], letters.at(info.coin).second);
+        BOOST_CHECK_EQUAL(p->Bech32HRP(), std::string{info.bech32_hrp[0]});
+    }
+}
+
+// Each chain's money limit is 21 million x multiplier; original Bitcoin keeps 21 million.
+BOOST_AUTO_TEST_CASE(money_limit_per_chain)
+{
+    for (const auto& info : COIN_TABLE) {
+        gArgs.ForceSetArg("-coin", std::string{info.name});
+        SelectParams(ChainType::REGTEST);
+        BOOST_CHECK_EQUAL(MAX_MONEY, 21000000 * COIN * info.multiplier);
+        BOOST_CHECK(MoneyRange(21000000 * COIN * info.multiplier));
+        BOOST_CHECK(!MoneyRange(21000000 * COIN * info.multiplier + 1));
+        BOOST_CHECK(MAX_MONEY <= COIN_SERIES_MAX_MONEY_CEILING);
+    }
+    gArgs.ForceSetArg("-coin", "");
+    SelectParams(ChainType::MAIN);
+    BOOST_CHECK_EQUAL(MAX_MONEY, 21000000 * COIN);
+    BOOST_CHECK(!MoneyRange(21000000 * COIN + 1));
+}
+
+BOOST_AUTO_TEST_SUITE_END()
