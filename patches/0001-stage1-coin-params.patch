 CAmount GetBlockSubsidy(int nHeight, const Consensus::Params& consensusParams)
 {
-    int halvings = nHeight / consensusParams.nSubsidyHalvingInterval;
+    // Coin Series: the genesis block of a Coin Series chain pays nothing.
+    if (consensusParams.nSnapshotHeight > 0 && nHeight == 0) return 0;
+    // Coin Series: new-chain height h is rewarded as Bitcoin height nSnapshotHeight + h.
+    // For original Bitcoin nSnapshotHeight = 0 and nSupplyMultiplier = 1, so this is unchanged.
+    const int64_t virtual_height = int64_t{consensusParams.nSnapshotHeight} + nHeight;
+    const int64_t halvings = virtual_height / consensusParams.nSubsidyHalvingInterval;
     // Force block reward to zero when right shift is undefined.
     if (halvings >= 64)
         return 0;
 
-    CAmount nSubsidy = 50 * COIN;
+    // Multiply first, then halve (intended: late-era rewards differ slightly from Bitcoin reward x multiplier).
+    CAmount nSubsidy = 50 * COIN * consensusParams.nSupplyMultiplier;
     // Subsidy is cut in half every 210,000 blocks which will occur approximately every 4 years.
     nSubsidy >>= halvings;
     return nSubsidy;
