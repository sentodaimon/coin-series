diff --git a/src/kernel/coinseries.h b/src/kernel/coinseries.h
new file mode 100644
index 0000000..0e7574e
--- /dev/null
+++ b/src/kernel/coinseries.h
@@ -0,0 +1,100 @@
+// Copyright (c) 2026 Sento Daimon
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef BITCOIN_KERNEL_COINSERIES_H
+#define BITCOIN_KERNEL_COINSERIES_H
+
+#include <util/chaintype.h>
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+
+/**
+ * Bitcoin Coin Series: five independent chains (Half, Quarter, Dime, Nickel, Cent)
+ * built from one source tree. Selected with -coin=<name>. Without -coin the
+ * software behaves as original Bitcoin Core (kept for regression testing).
+ */
+enum class CoinSeriesId : uint8_t {
+    NONE = 0,
+    HALF,
+    QUARTER,
+    DIME,
+    NICKEL,
+    CENT,
+};
+
+/** Index of the network environment within a coin (main / test / regtest). */
+enum class CoinEnv : uint8_t { MAIN = 0, TEST = 1, REGTEST = 2 };
+
+struct CoinInfo {
+    CoinSeriesId coin;
+    std::string_view name;    //!< value of -coin=
+    std::string_view title;   //!< human readable name
+    std::string_view ticker;
+    int64_t multiplier;       //!< supply multiplier versus Bitcoin
+    uint8_t merge_slot;       //!< merged mining slot 0..4
+    uint16_t p2p_port_main;   //!< test = +10000, regtest = +20000
+    uint16_t rpc_port_main;   //!< test = +10000, regtest = +20000
+    std::array<std::string_view, 3> bech32_hrp;   //!< main, test, regtest
+    std::array<uint8_t, 3> pubkey_prefix;          //!< base58 P2PKH version byte per env
+    std::array<uint8_t, 3> script_prefix;          //!< base58 P2SH version byte per env
+    std::array<uint8_t, 3> secret_prefix;          //!< base58 WIF version byte per env
+};
+
+inline constexpr std::array<CoinInfo, 5> COIN_TABLE{{
+    {CoinSeriesId::HALF,    "half",    "Bitcoin Half",    "BTCH", 2,   0, 38302, 38202, {"hf", "thf", "rhf"}, {40, 130, 140}, {100, 135, 145}, {168, 200, 210}},
+    {CoinSeriesId::QUARTER, "quarter", "Bitcoin Quarter", "BTCQ", 4,   1, 38304, 38204, {"qt", "tqt", "rqt"}, {58, 131, 141}, {120, 136, 146}, {186, 201, 211}},
+    {CoinSeriesId::DIME,    "dime",    "Bitcoin Dime",    "BTCD", 10,  2, 38310, 38210, {"dm", "tdm", "rdm"}, {30, 132, 142}, {90, 137, 147},  {158, 202, 212}},
+    {CoinSeriesId::NICKEL,  "nickel",  "Bitcoin Nickel",  "BTCN", 20,  3, 38320, 38220, {"nk", "tnk", "rnk"}, {53, 133, 143}, {112, 138, 148}, {181, 203, 213}},
+    {CoinSeriesId::CENT,    "cent",    "Bitcoin Cent",    "BTCC", 100, 4, 38400, 38300, {"ct", "tct", "rct"}, {28, 134, 144}, {87, 139, 149},  {156, 204, 214}},
+}};
+
+inline const CoinInfo* GetCoinInfo(CoinSeriesId coin)
+{
+    for (const auto& info : COIN_TABLE) {
+        if (info.coin == coin) return &info;
+    }
+    return nullptr;
+}
+
+/** Parse a -coin= value. Empty string or "bitcoin" means NONE. Returns nullopt if unknown. */
+inline std::optional<CoinSeriesId> CoinFromString(std::string_view name)
+{
+    if (name.empty() || name == "bitcoin") return CoinSeriesId::NONE;
+    for (const auto& info : COIN_TABLE) {
+        if (info.name == name) return info.coin;
+    }
+    return std::nullopt;
+}
+
+/** Map a Bitcoin chain type to a coin environment. Only main, test and regtest are supported. */
+inline std::optional<CoinEnv> CoinEnvFromChainType(ChainType chain)
+{
+    switch (chain) {
+    case ChainType::MAIN: return CoinEnv::MAIN;
+    case ChainType::TESTNET: return CoinEnv::TEST;
+    case ChainType::REGTEST: return CoinEnv::REGTEST;
+    case ChainType::TESTNET4:
+    case ChainType::SIGNET:
+        return std::nullopt;
+    }
+    return std::nullopt;
+}
+
+inline std::string_view CoinEnvName(CoinEnv env)
+{
+    switch (env) {
+    case CoinEnv::MAIN: return "mainnet";
+    case CoinEnv::TEST: return "testnet";
+    case CoinEnv::REGTEST: return "regtest";
+    }
+    return "";
+}
+
+#define LIST_COIN_NAMES "half, quarter, dime, nickel, cent"
+
+#endif // BITCOIN_KERNEL_COINSERIES_H
