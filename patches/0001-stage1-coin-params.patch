+/**
+ * Coin Series chain parameters (Half, Quarter, Dime, Nickel, Cent).
+ *
+ * Development stage: proof of work is still Bitcoin's SHA256d with placeholder
+ * limits, and the genesis block is a development placeholder. RandomX merged
+ * mining, ASERT difficulty with stall relief, signature chain identifiers,
+ * snapshot claims and the launch-bound genesis are added in later stages.
+ */
+class CCoinSeriesParams : public CChainParams
+{
+public:
+    CCoinSeriesParams(const CoinInfo& info, CoinEnv env, ChainType chain, const RegTestOptions& opts)
+    {
+        const size_t e = static_cast<size_t>(env);
+        m_chain_type = chain;
+
+        consensus.signet_blocks = false;
+        consensus.signet_challenge.clear();
+        consensus.script_flag_exceptions.clear();
+
+        // Supply rules (decided): Bitcoin schedule continued from the snapshot height, times the multiplier.
+        consensus.nSubsidyHalvingInterval = 210000;
+        consensus.nSupplyMultiplier = info.multiplier;
+        consensus.nSnapshotHeight = 840000;
+        consensus.nMergeSlot = info.merge_slot;
+        // Chain identifier for signatures: distinct per coin and environment. Used from the signing stage.
+        consensus.nChainSigId = 0x43530000u | (uint32_t{info.merge_slot} << 8) | uint32_t(e);
+
+        // All of Bitcoin's rules (BIP34/65/66, CSV, SegWit, Taproot) are active from the first block.
+        consensus.BIP34Height = 1;
+        consensus.BIP34Hash = uint256();
+        consensus.BIP65Height = 1;
+        consensus.BIP66Height = 1;
+        consensus.CSVHeight = 1;
+        consensus.SegwitHeight = 0;
+        consensus.MinBIP9WarningHeight = 0;
+
+        consensus.nPowTargetSpacing = 10 * 60;
+        if (env == CoinEnv::REGTEST) {
+            consensus.powLimit = uint256{"7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"};
+            consensus.nPowTargetTimespan = 24 * 60 * 60;
+            consensus.fPowAllowMinDifficultyBlocks = true;
+            consensus.fPowNoRetargeting = true;
+            consensus.enforce_BIP94 = opts.enforce_bip94;
+        } else {
+            // Placeholder until the RandomX / ASERT stage replaces proof of work and difficulty.
+            consensus.powLimit = uint256{"00000fffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"};
+            consensus.nPowTargetTimespan = 14 * 24 * 60 * 60;
+            consensus.fPowAllowMinDifficultyBlocks = (env == CoinEnv::TEST);
+            consensus.fPowNoRetargeting = false;
+            consensus.enforce_BIP94 = (env == CoinEnv::TEST);
+        }
+
+        const int32_t period = env == CoinEnv::REGTEST ? 144 : 2016;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TESTDUMMY].bit = 28;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TESTDUMMY].nStartTime = Consensus::BIP9Deployment::NEVER_ACTIVE;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TESTDUMMY].nTimeout = Consensus::BIP9Deployment::NO_TIMEOUT;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TESTDUMMY].min_activation_height = 0;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TESTDUMMY].threshold = period * 3 / 4;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TESTDUMMY].period = period;
+
+        consensus.vDeployments[Consensus::DEPLOYMENT_TAPROOT].bit = 2;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TAPROOT].nStartTime = Consensus::BIP9Deployment::ALWAYS_ACTIVE;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TAPROOT].nTimeout = Consensus::BIP9Deployment::NO_TIMEOUT;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TAPROOT].min_activation_height = 0;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TAPROOT].threshold = period * 3 / 4;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TAPROOT].period = period;
+
+        if (env == CoinEnv::REGTEST) {
+            for (const auto& [dep, height] : opts.activation_heights) {
+                switch (dep) {
+                case Consensus::BuriedDeployment::DEPLOYMENT_SEGWIT: consensus.SegwitHeight = int{height}; break;
+                case Consensus::BuriedDeployment::DEPLOYMENT_HEIGHTINCB: consensus.BIP34Height = int{height}; break;
+                case Consensus::BuriedDeployment::DEPLOYMENT_DERSIG: consensus.BIP66Height = int{height}; break;
+                case Consensus::BuriedDeployment::DEPLOYMENT_CLTV: consensus.BIP65Height = int{height}; break;
+                case Consensus::BuriedDeployment::DEPLOYMENT_CSV: consensus.CSVHeight = int{height}; break;
+                }
+            }
+            for (const auto& [deployment_pos, vbp] : opts.version_bits_parameters) {
+                consensus.vDeployments[deployment_pos].nStartTime = vbp.start_time;
+                consensus.vDeployments[deployment_pos].nTimeout = vbp.timeout;
+                consensus.vDeployments[deployment_pos].min_activation_height = vbp.min_activation_height;
+            }
+        }
+
+        // New chains: no Bitcoin history to trust.
+        consensus.nMinimumChainWork = uint256{};
+        consensus.defaultAssumeValid = uint256{};
+
+        // Network magic: first 4 bytes of SHA256("coin-series/<coin>/<environment>").
+        const std::string magic_tag = strprintf("coin-series/%s/%s", std::string{info.name}, std::string{CoinEnvName(env)});
+        unsigned char digest[CSHA256::OUTPUT_SIZE];
+        CSHA256().Write(reinterpret_cast<const unsigned char*>(magic_tag.data()), magic_tag.size()).Finalize(digest);
+        std::copy(digest, digest + 4, pchMessageStart.begin());
+
+        nDefaultPort = info.p2p_port_main + 10000 * e;
+        nPruneAfterHeight = env == CoinEnv::REGTEST ? (opts.fastprune ? 100 : 1000) : 100000;
+        m_assumed_blockchain_size = 0;
+        m_assumed_chain_state_size = 0;
+
+        // Development placeholder genesis. Replaced at launch by the genesis bound to a future Bitcoin block.
+        const uint32_t genesis_bits = UintToArith256(consensus.powLimit).GetCompact();
+        const std::string genesis_msg = strprintf("Coin Series %s %s development genesis", std::string{info.title}, std::string{CoinEnvName(env)});
+        const CScript genesis_script = CScript() << OP_RETURN;
+        genesis = CreateGenesisBlock(genesis_msg.c_str(), genesis_script, 1790812800, 0, genesis_bits, 1, /*genesisReward=*/0);
+        const arith_uint256 target = arith_uint256().SetCompact(genesis_bits);
+        while (UintToArith256(genesis.GetHash()) > target) ++genesis.nNonce;
+        consensus.hashGenesisBlock = genesis.GetHash();
+
+        vFixedSeeds.clear();
+        vSeeds.clear();
+
+        fDefaultConsistencyChecks = (env == CoinEnv::REGTEST);
+        m_is_mockable_chain = (env == CoinEnv::REGTEST);
+        m_assumeutxo_data.clear();
+        chainTxData = ChainTxData{.nTime = 0, .tx_count = 0, .dTxRate = 0.001};
+
+        base58Prefixes[PUBKEY_ADDRESS] = std::vector<unsigned char>(1, info.pubkey_prefix[e]);
+        base58Prefixes[SCRIPT_ADDRESS] = std::vector<unsigned char>(1, info.script_prefix[e]);
+        base58Prefixes[SECRET_KEY] = std::vector<unsigned char>(1, info.secret_prefix[e]);
+        if (env == CoinEnv::MAIN) {
+            base58Prefixes[EXT_PUBLIC_KEY] = {0x04, 0x88, 0xB2, 0x1E};
+            base58Prefixes[EXT_SECRET_KEY] = {0x04, 0x88, 0xAD, 0xE4};
+        } else {
+            base58Prefixes[EXT_PUBLIC_KEY] = {0x04, 0x35, 0x87, 0xCF};
+            base58Prefixes[EXT_SECRET_KEY] = {0x04, 0x35, 0x83, 0x94};
+        }
+        bech32_hrp = std::string{info.bech32_hrp[e]};
+
+        m_headers_sync_params = HeadersSyncParams{
+            .commitment_period = 275,
+            .redownload_buffer_size = 7017,
+        };
+    }
+};
+
+std::unique_ptr<const CChainParams> CChainParams::CoinSeries(CoinSeriesId coin, ChainType chain, const RegTestOptions& regtest_options)
+{
+    const CoinInfo* info = GetCoinInfo(coin);
+    const auto env = CoinEnvFromChainType(chain);
+    if (!info || !env) {
+        throw std::runtime_error(strprintf("Coin Series supports only -chain=main, test or regtest (got %s)", ChainTypeToString(chain)));
+    }
+    return std::make_unique<const CCoinSeriesParams>(*info, *env, chain, regtest_options);
+}
