+CoinSeriesId GetCoinArg(const ArgsManager& args)
+{
+    const std::string value = args.GetArg("-coin", "");
+    const auto coin = CoinFromString(value);
+    if (!coin) throw std::runtime_error(strprintf("Unknown -coin value '%s'. Allowed values: %s", value, LIST_COIN_NAMES));
+    return *coin;
+}
+
+std::unique_ptr<CBaseChainParams> CreateBaseChainParams(const ChainType chain, const CoinSeriesId coin)
+{
+    if (coin == CoinSeriesId::NONE) return CreateBaseChainParams(chain);
+    const CoinInfo* info = GetCoinInfo(coin);
+    const auto env = CoinEnvFromChainType(chain);
+    if (!info || !env) throw std::runtime_error(strprintf("Coin Series supports only -chain=main, test or regtest (got %s)", ChainTypeToString(chain)));
+    const size_t e = static_cast<size_t>(*env);
+    std::string data_dir{info->name};
+    if (*env != CoinEnv::MAIN) data_dir += "-" + std::string{CoinEnvName(*env)};
+    return std::make_unique<CBaseChainParams>(data_dir, static_cast<uint16_t>(info->rpc_port_main + 10000 * e));
+}
+
 void SelectBaseParams(const ChainType chain)
 {
-    globalChainBaseParams = CreateBaseChainParams(chain);
+    globalChainBaseParams = CreateBaseChainParams(chain, GetCoinArg(gArgs));
     gArgs.SelectConfigNetwork(ChainTypeToString(chain));
 }
