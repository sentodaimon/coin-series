index 0000000..4e545f0
--- /dev/null
+++ b/contrib/coinseries/regtest_smoke.sh
@@ -0,0 +1,50 @@
+#!/usr/bin/env bash
+# Coin Series regtest smoke test: for each coin, start a node, mine, check reward and addresses, send a transaction.
+# Usage: contrib/coinseries/regtest_smoke.sh <build/bin directory>
+set -euo pipefail
+BIN=${1:-build/bin}
+WORK=$(mktemp -d)
+trap 'for c in half quarter dime nickel cent; do "$BIN/bitcoin-cli" -datadir="$WORK" -coin=$c -regtest stop >/dev/null 2>&1 || true; done; sleep 2; rm -rf "$WORK"' EXIT
+
+declare -A MULT=([half]=2 [quarter]=4 [dime]=10 [nickel]=20 [cent]=100)
+declare -A HRP=([half]=rhf [quarter]=rqt [dime]=rdm [nickel]=rnk [cent]=rct)
+FAIL=0
+
+# Start all five nodes at once to prove they coexist (separate ports and data directories).
+for c in half quarter dime nickel cent; do
+  "$BIN/bitcoind" -datadir="$WORK" -coin=$c -regtest -daemon -fallbackfee=0.0001 -listen=1 >/dev/null
+done
+sleep 6
+
+for c in half quarter dime nickel cent; do
+  CLI=("$BIN/bitcoin-cli" -datadir="$WORK" -coin=$c -regtest)
+  "${CLI[@]}" -rpcwait createwallet w >/dev/null
+  ADDR=$("${CLI[@]}" getnewaddress)
+  "${CLI[@]}" generatetoaddress 101 "$ADDR" >/dev/null
+  BAL=$("${CLI[@]}" getbalance)
+  EXPECT=$(python3 -c "print(f'{3.125*${MULT[$c]}:.8f}')")
+  INFO=$("${CLI[@]}" getblockchaininfo)
+  CHAIN=$(echo "$INFO" | python3 -c "import sys,json;print(json.load(sys.stdin)['chain'])")
+  DEST=$("${CLI[@]}" getnewaddress "" bech32)
+  LEGACY=$("${CLI[@]}" getnewaddress "" legacy)
+  TXID=$("${CLI[@]}" sendtoaddress "$DEST" 1)
+  "${CLI[@]}" generatetoaddress 1 "$ADDR" >/dev/null
+  CONF=$("${CLI[@]}" gettransaction "$TXID" | python3 -c "import sys,json;print(json.load(sys.stdin)['confirmations'])")
+  PORT=$("${CLI[@]}" getnetworkinfo | python3 -c "import sys,json;d=json.load(sys.stdin);print(d['localaddresses'][0]['port'] if d['localaddresses'] else '-')")
+  OK=yes
+  [[ "$BAL" == "$EXPECT" ]] || OK=no
+  [[ "$ADDR" == ${HRP[$c]}1* ]] || OK=no
+  [[ "$CONF" == "1" ]] || OK=no
+  printf "%-8s chain=%-8s matured_reward=%-14s expected=%-14s bech32=%s... legacy=%s... tx_confirmed=%s  %s\n" \
+    "$c" "$CHAIN" "$BAL" "$EXPECT" "${ADDR:0:8}" "${LEGACY:0:4}" "$CONF" "$([[ $OK == yes ]] && echo PASS || echo FAIL)"
+  [[ $OK == yes ]] || FAIL=1
+done
+
+# A bech32 address of one coin must be rejected by another coin's node.
+HALF_ADDR=$("$BIN/bitcoin-cli" -datadir="$WORK" -coin=half -regtest getnewaddress)
+if "$BIN/bitcoin-cli" -datadir="$WORK" -coin=cent -regtest validateaddress "$HALF_ADDR" | grep -q '"isvalid": false'; then
+  echo "cross-chain address rejected: PASS"
+else
+  echo "cross-chain address rejected: FAIL"; FAIL=1
+fi
+exit $FAIL
