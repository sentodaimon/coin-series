@@ -587,9 +591,21 @@ BOOST_AUTO_TEST_CASE(genesis_from_beacon_header)
     BOOST_CHECK_EQUAL(half_a->GenesisBlock().nTime, 1800000000U);                                      // time = block H time
     BOOST_CHECK_EQUAL(half_a->GenesisBlock().vtx[0]->GetValueOut(), 0);
     const CScript& sig = half_a->GenesisBlock().vtx[0]->vin[0].scriptSig;
-    const std::string expected_text = "coin-series/half/regtest/" + a_hash.GetHex();
+    const std::string expected_text = "cs/half/regtest/" + a_hash.GetHex();
     BOOST_CHECK(std::search(sig.begin(), sig.end(), expected_text.begin(), expected_text.end()) != sig.end());
 
+    // Every coin and network derives a valid genesis coinbase (scriptSig within 100 bytes) from a real
