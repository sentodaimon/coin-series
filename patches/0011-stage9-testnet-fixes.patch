From 8acaa3920cd88ee9b24b10cb2dc677d682e59ae9 Mon Sep 17 00:00:00 2001
From: Sento Daimon <sentodaimon@users.noreply.github.com>
Date: Sat, 31 Oct 2026 17:16:54 +0900
Subject: [PATCH 2/6] Windows: 64-bit file seek/tell in AutoFile (claim
 snapshot is ~9 GB)

---
 src/streams.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/streams.cpp b/src/streams.cpp
index e38b959..8c08e37 100644
--- a/src/streams.cpp
+++ b/src/streams.cpp
@@ -35,7 +35,13 @@ void AutoFile::seek(int64_t offset, int origin)
     if (IsNull()) {
         throw std::ios_base::failure("AutoFile::seek: file handle is nullptr");
     }
+#ifdef WIN32
+    // Windows' fseek/ftell use a 32-bit long; the 64-bit variants are needed for files over 2 GiB
+    // (the Coin Series claim snapshot is about 9 GB).
+    if (_fseeki64(m_file, offset, origin) != 0) {
+#else
     if (std::fseek(m_file, offset, origin) != 0) {
+#endif
         throw std::ios_base::failure(feof() ? "AutoFile::seek: end of file" : "AutoFile::seek: fseek failed");
     }
     if (origin == SEEK_SET) {
@@ -43,7 +49,11 @@ void AutoFile::seek(int64_t offset, int origin)
     } else if (origin == SEEK_CUR && m_position.has_value()) {
         *m_position += offset;
     } else {
+#ifdef WIN32
+        int64_t r{_ftelli64(m_file)};
+#else
         int64_t r{std::ftell(m_file)};
+#endif
         if (r < 0) {
             throw std::ios_base::failure("AutoFile::seek: ftell failed");
         }
-- 
2.43.0


