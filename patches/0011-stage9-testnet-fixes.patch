From b4f7aec1cce0c784f414de1b1bc9b91605117ea2 Mon Sep 17 00:00:00 2001
From: Sento Daimon <sentodaimon@users.noreply.github.com>
Date: Sat, 31 Oct 2026 18:52:29 +0900
Subject: [PATCH 6/6] Windows testnet kit: one-click 7-day testnet start (H =
 973949)

---
 .../windows-testnet/00-settings.bat           | 18 ++++----
 .../windows-testnet/start-7day-testnet.bat    | 42 +++++++++++++++++++
 2 files changed, 51 insertions(+), 9 deletions(-)
 create mode 100644 contrib/coinseries/windows-testnet/start-7day-testnet.bat

diff --git a/contrib/coinseries/windows-testnet/00-settings.bat b/contrib/coinseries/windows-testnet/00-settings.bat
index 27b545a..cb19bde 100644
--- a/contrib/coinseries/windows-testnet/00-settings.bat
+++ b/contrib/coinseries/windows-testnet/00-settings.bat
@@ -1,12 +1,12 @@
 @echo off
-rem ===== Coin Series testnet settings (edit only this file) =====
-rem Data folder: blocks, wallets and the snapshot live here (use a drive with 30 GB free)
-set DATA=D:\CoinSeriesData
-rem 80-byte header (160 hex characters) of the announced Bitcoin block H. Filled in on launch day.
-set BEACON=
-rem Address of another testnet node to connect to (example 1.2.3.4). Leave empty for the first node.
+rem ===== Coin Series 7-day testnet settings =====
+rem Data folder for the 7-day testnet (separate from the rehearsal in C:\CoinSeries\data)
+set DATA=C:\CoinSeries\testnet7b
+rem Bitcoin block H = height 973949 (000000000000000000008ccd8d61fc581bb25d1917939059edd7d7e2c10bb4f6)
+set BEACON=00c0de27d58b01d405ecac61dd54ee345255419583b3cf88979a00000000000000000000fa55c47cfa893204327b660672d0dac69a7b7f985a2883504978e892b6737d00359ee56aace5011782bc0de1
+rem Address of another testnet node to connect to (empty for the first node)
 set SEED=
-rem Mining threads (default: all CPU threads; lower it if the PC gets too hot or slow)
+rem Mining threads (default: all CPU threads)
 set THREADS=%NUMBER_OF_PROCESSORS%
-rem Development only: start without the snapshot. Normally leave empty.
-set EXTRA=
+rem Use the already verified snapshot from the rehearsal folder (no 9 GB copy)
+set EXTRA=-claimsnapshot=C:\CoinSeries\data\snapshot\utxo-840000.dat
diff --git a/contrib/coinseries/windows-testnet/start-7day-testnet.bat b/contrib/coinseries/windows-testnet/start-7day-testnet.bat
new file mode 100644
index 0000000..f0735a7
--- /dev/null
+++ b/contrib/coinseries/windows-testnet/start-7day-testnet.bat
@@ -0,0 +1,42 @@
+@echo off
+setlocal EnableDelayedExpansion
+cd /d "%~dp0"
+echo ==== Coin Series 7-day testnet: one-click start ====
+echo Do not click inside any black window (that pauses it).
+echo [1/4] Stopping earlier runs (C:\CoinSeries\data, C:\CoinSeries\testnet7) ...
+taskkill /im cs-miner.exe /f >nul 2>&1
+for %%c in (half quarter dime nickel cent) do bitcoin-cli.exe -datadir="C:\CoinSeries\data" -chain=test -coin=%%c stop >nul 2>&1
+for %%c in (half quarter dime nickel cent) do bitcoin-cli.exe -datadir="C:\CoinSeries\testnet7" -chain=test -coin=%%c stop >nul 2>&1
+timeout /t 20 /nobreak >nul
+call 00-settings.bat
+if not exist "%DATA%" mkdir "%DATA%"
+echo [2/4] Starting the five 7-day testnet nodes (snapshot check takes about 3 minutes) ...
+set OPT=-datadir="%DATA%" -chain=test -beaconheader=%BEACON%
+if not "%SEED%"=="" set OPT=%OPT% -addnode=%SEED%
+for %%c in (half quarter dime nickel cent) do start "testnet7 %%c" /min bitcoind.exe %OPT% -coin=%%c %EXTRA%
+echo [3/4] Waiting for each node, then creating wallets and addresses ...
+for %%c in (half quarter dime nickel cent) do call :ready %%c
+echo [4/4] Starting the miner in its own window. Log: %DATA%\mining-log.txt
+start "testnet7 miner" /min cmd /c t2-mine-testnet.bat
+echo All started. You can close THIS window. Keep the node and miner windows open.
+pause
+exit /b 0
+
+:ready
+set C=%1
+set /a TRIES=0
+:wait
+bitcoin-cli.exe -datadir="%DATA%" -chain=test -coin=%C% getblockcount >nul 2>&1
+if errorlevel 1 (
+  set /a TRIES+=1
+  if !TRIES! GEQ 60 (
+    echo   %C% node did not start in 10 minutes - see %DATA%\%C%-testnet\debug.log
+    exit /b 1
+  )
+  timeout /t 10 /nobreak >nul
+  goto wait
+)
+bitcoin-cli.exe -datadir="%DATA%" -chain=test -coin=%C% createwallet w >nul 2>&1
+bitcoin-cli.exe -datadir="%DATA%" -chain=test -coin=%C% loadwallet w >nul 2>&1
+echo   %C% node ready
+exit /b 0
-- 
2.43.0

