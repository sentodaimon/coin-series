From bd07216b69a3e9373dc83a2cae4fe5beaba0b2ba Mon Sep 17 00:00:00 2001
From: Sento Daimon <339524263+sentodaimon@users.noreply.github.com>
Date: Thu, 29 Oct 2026 15:39:18 +0900
Subject: [PATCH] Coin Series stage 4: replay protection - chain identifier in
 every signature hash

- nChainSigId (distinct per coin and environment) appended to the legacy, SegWit v0 and Taproot
  signature hash preimages; the legacy SIGHASH_SINGLE special case becomes chain specific
- set at startup by SelectParams; per-thread override (SighashChainIdScope) so claim ownership
  proofs can be verified with Bitcoin's original rules
- tests: pkh / wpkh / tr, SIGHASH_ALL and SINGLE|ANYONECANPAY: valid on own chain, rejected on
  another coin, on the same coin's testnet and on Bitcoin; wallet spends on regtest
---
 src/chainparams.cpp           |  3 ++
 src/script/interpreter.cpp    |  9 ++++
 src/script/interpreter.h      | 20 +++++++++
 src/test/coinseries_tests.cpp | 80 +++++++++++++++++++++++++++++++++++
 4 files changed, 112 insertions(+)

diff --git a/src/chainparams.cpp b/src/chainparams.cpp
index 8183722..652c372 100644
--- a/src/chainparams.cpp
+++ b/src/chainparams.cpp
@@ -9,6 +9,7 @@
 #include <common/args.h>
 #include <consensus/amount.h>
 #include <primitives/block.h>
+#include <script/interpreter.h>
 #include <consensus/params.h>
 #include <deploymentinfo.h>
 #include <logging.h>
@@ -153,4 +154,6 @@ void SelectParams(const ChainType chain)
     SetMaxMoneyForMultiplier(globalChainParams->GetConsensus().nSupplyMultiplier);
     // Coin Series: header serialization format (180-byte Coin Series header vs 80-byte Bitcoin header).
     g_coin_series_header = globalChainParams->GetConsensus().nMergeSlot >= 0;
+    // Coin Series: chain identifier mixed into signature hashes (replay protection; 0 for Bitcoin).
+    g_sighash_chain_id = globalChainParams->GetConsensus().nChainSigId;
 }
diff --git a/src/script/interpreter.cpp b/src/script/interpreter.cpp
index 443714c..d2613ee 100644
--- a/src/script/interpreter.cpp
+++ b/src/script/interpreter.cpp
@@ -1565,6 +1565,7 @@ bool SignatureHashSchnorr(uint256& hash_out, ScriptExecutionData& execdata, cons
         ss << execdata.m_codeseparator_pos;
     }
 
+    if (const uint32_t chain_id = SighashChainId()) ss << chain_id; // Coin Series replay protection
     hash_out = ss.GetSHA256();
     return true;
 }
@@ -1606,6 +1607,12 @@ uint256 SignatureHash(const CScript& scriptCode, const T& txTo, unsigned int nIn
         if ((nHashType & 0x1f) == SIGHASH_SINGLE) {
             if (nIn >= txTo.vout.size()) {
                 //  nOut out of range
+                // Coin Series: even this historical special case must not be replayable across chains.
+                if (const uint32_t chain_id = SighashChainId()) {
+                    HashWriter h{};
+                    h << uint256::ONE << chain_id;
+                    return h.GetHash();
+                }
                 return uint256::ONE;
             }
         }
@@ -1617,6 +1624,7 @@ uint256 SignatureHash(const CScript& scriptCode, const T& txTo, unsigned int nIn
     if (sighash_cache && sighash_cache->Load(nHashType, scriptCode, ss)) {
         // Add sighash type and hash.
         ss << nHashType;
+        if (const uint32_t chain_id = SighashChainId()) ss << chain_id; // Coin Series replay protection
         return ss.GetHash();
     }
 
@@ -1673,6 +1681,7 @@ uint256 SignatureHash(const CScript& scriptCode, const T& txTo, unsigned int nIn
 
     // Add sighash type and hash.
     ss << nHashType;
+    if (const uint32_t chain_id = SighashChainId()) ss << chain_id; // Coin Series replay protection
     return ss.GetHash();
 }
 
diff --git a/src/script/interpreter.h b/src/script/interpreter.h
index cbb137e..03d656a 100644
--- a/src/script/interpreter.h
+++ b/src/script/interpreter.h
@@ -373,6 +373,26 @@ uint256 ComputeTapbranchHash(std::span<const unsigned char> a, std::span<const u
  *  Requires control block to have valid length (33 + k*32, with k in {0,1,..,128}). */
 uint256 ComputeTaprootMerkleRoot(std::span<const unsigned char> control, const uint256& tapleaf_hash);
 
+/**
+ * Coin Series replay protection: a chain identifier mixed into every signature hash
+ * (legacy, SegWit v0 and Taproot), so a signature made for one chain is invalid on any other chain
+ * and on Bitcoin. 0 = original Bitcoin (nothing mixed in). Set once at startup by SelectParams().
+ */
+inline uint32_t g_sighash_chain_id{0};
+/** Per-thread override, used to verify Bitcoin-signed ownership proofs (claims) with Bitcoin's own rules. */
+inline thread_local std::optional<uint32_t> g_sighash_chain_id_override{};
+inline uint32_t SighashChainId() { return g_sighash_chain_id_override ? *g_sighash_chain_id_override : g_sighash_chain_id; }
+/** RAII helper: compute/verify signature hashes for a given chain identifier on this thread. */
+class SighashChainIdScope
+{
+    std::optional<uint32_t> m_prev;
+public:
+    explicit SighashChainIdScope(uint32_t id) : m_prev{g_sighash_chain_id_override} { g_sighash_chain_id_override = id; }
+    ~SighashChainIdScope() { g_sighash_chain_id_override = m_prev; }
+    SighashChainIdScope(const SighashChainIdScope&) = delete;
+    SighashChainIdScope& operator=(const SighashChainIdScope&) = delete;
+};
+
 bool EvalScript(std::vector<std::vector<unsigned char> >& stack, const CScript& script, script_verify_flags flags, const BaseSignatureChecker& checker, SigVersion sigversion, ScriptExecutionData& execdata, ScriptError* error = nullptr);
 bool EvalScript(std::vector<std::vector<unsigned char> >& stack, const CScript& script, script_verify_flags flags, const BaseSignatureChecker& checker, SigVersion sigversion, ScriptError* error = nullptr);
 bool VerifyScript(const CScript& scriptSig, const CScript& scriptPubKey, const CScriptWitness* witness, script_verify_flags flags, const BaseSignatureChecker& checker, ScriptError* serror = nullptr);
