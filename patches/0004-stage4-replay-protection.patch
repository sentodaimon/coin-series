@@ -454,4 +459,79 @@ BOOST_AUTO_TEST_CASE(asert_stall_simulation)
     BOOST_CHECK(median(recover) <= 48.0);
 }
 
+// Replay protection: a signature made on one chain is invalid on every other chain and on Bitcoin.
+BOOST_AUTO_TEST_CASE(replay_protection)
+{
+    const std::set<uint32_t> ids = [] {
+        std::set<uint32_t> r;
+        for (const auto& info : COIN_TABLE) {
+            for (ChainType env : ENVS) r.insert(Make(info.coin, env)->GetConsensus().nChainSigId);
+        }
+        return r;
+    }();
+    BOOST_CHECK_EQUAL(ids.size(), 15U);
+    BOOST_CHECK(!ids.contains(0));
+
+    const uint32_t half_main = Make(CoinSeriesId::HALF, ChainType::MAIN)->GetConsensus().nChainSigId;
+    const uint32_t cent_main = Make(CoinSeriesId::CENT, ChainType::MAIN)->GetConsensus().nChainSigId;
+    const uint32_t half_test = Make(CoinSeriesId::HALF, ChainType::TESTNET)->GetConsensus().nChainSigId;
+
+    const CKey key = GenerateRandomKey();
+    const std::string wif = EncodeSecret(key);
+    const script_verify_flags flags = SCRIPT_VERIFY_P2SH | SCRIPT_VERIFY_WITNESS | SCRIPT_VERIFY_TAPROOT |
+                                      SCRIPT_VERIFY_DERSIG | SCRIPT_VERIFY_LOW_S | SCRIPT_VERIFY_NULLFAIL | SCRIPT_VERIFY_STRICTENC;
+    for (const std::string type : {"pkh", "wpkh", "tr"}) {
+        FlatSigningProvider keys;
+        std::string error;
+        auto descs = Parse(type + "(" + wif + ")", keys, error, /*require_checksum=*/false);
+        BOOST_REQUIRE_MESSAGE(descs.size() == 1, error);
+        std::vector<CScript> spks;
+        FlatSigningProvider provider;
+        BOOST_REQUIRE(descs[0]->Expand(0, keys, spks, provider));
+        provider.Merge(FlatSigningProvider{keys});
+        const CAmount amount = 5 * COIN;
+        const CTxOut spent{amount, spks[0]};
+
+        for (int hashtype : std::vector<int>{SIGHASH_ALL, SIGHASH_SINGLE | SIGHASH_ANYONECANPAY}) {
+            CMutableTransaction tx;
+            tx.version = 2;
+            tx.vin.emplace_back(COutPoint{Txid::FromUint256(uint256::ONE), 0});
+            tx.vout.emplace_back(amount - 1000, CScript() << OP_TRUE);
+            PrecomputedTransactionData txdata;
+            txdata.Init(tx, {spent}, /*force=*/true);
+
+            auto verify = [&](uint32_t id) {
+                SighashChainIdScope scope{id};
+                PrecomputedTransactionData vdata;
+                vdata.Init(tx, {spent}, /*force=*/true);
+                MutableTransactionSignatureChecker checker(&tx, 0, amount, vdata, MissingDataBehavior::FAIL);
+                return VerifyScript(tx.vin[0].scriptSig, spent.scriptPubKey, &tx.vin[0].scriptWitness, flags, checker);
+            };
+            {
+                SighashChainIdScope scope{half_main};
+                SignatureData sigdata;
+                MutableTransactionSignatureCreator creator(tx, 0, amount, &txdata, hashtype);
+                BOOST_REQUIRE(ProduceSignature(provider, creator, spent.scriptPubKey, sigdata));
+                UpdateInput(tx.vin[0], sigdata);
+            }
+            BOOST_CHECK_MESSAGE(verify(half_main), type << " valid on its own chain");
+            BOOST_CHECK_MESSAGE(!verify(cent_main), type << " rejected on another coin");
+            BOOST_CHECK_MESSAGE(!verify(half_test), type << " rejected on the same coin's testnet");
+            BOOST_CHECK_MESSAGE(!verify(0), type << " rejected on Bitcoin");
+        }
+    }
+
+    // Legacy SIGHASH_SINGLE with no matching output: Bitcoin's constant hash becomes chain specific.
+    CMutableTransaction tx;
+    tx.vin.resize(2);
+    tx.vout.resize(1);
+    const CScript code = CScript() << OP_TRUE;
+    uint256 btc, half, cent;
+    { SighashChainIdScope s{0}; btc = SignatureHash(code, tx, 1, SIGHASH_SINGLE, 0, SigVersion::BASE); }
+    { SighashChainIdScope s{half_main}; half = SignatureHash(code, tx, 1, SIGHASH_SINGLE, 0, SigVersion::BASE); }
+    { SighashChainIdScope s{cent_main}; cent = SignatureHash(code, tx, 1, SIGHASH_SINGLE, 0, SigVersion::BASE); }
+    BOOST_CHECK(btc == uint256::ONE);
+    BOOST_CHECK(half != btc && cent != btc && half != cent);
+}
+
 BOOST_AUTO_TEST_SUITE_END()
