+//
+// cs-miner: Coin Series merged miner. One RandomX computation mines all five chains.
+//
+//   cs-miner --coin half=ADDR --coin quarter=ADDR --coin dime=ADDR --coin nickel=ADDR --coin cent=ADDR
+//            [--chain main|test|regtest] [--datadir DIR] [--threads N] [--light] [--blocks N]
+//
+// It asks each local node for work (getmergework, same header time for all), builds the 8-leaf merge
+// tree, runs RandomX on root || nonce64 with N threads and submits to every chain whose target is met
+// (submitmergework). RPC authentication uses each node's .cookie file in the data directory.
+
+#include <randomx.h>
+#include <univalue.h>
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <iomanip>
+#include <iostream>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <random>
+#include <cstdlib>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <vector>
+
+#ifdef _WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+using socket_t = SOCKET;
+static void CloseSocket(socket_t s) { closesocket(s); }
+#else
+#include <netdb.h>
+#include <sys/socket.h>
+#include <unistd.h>
+using socket_t = int;
+static void CloseSocket(socket_t s) { close(s); }
+#endif
+
+namespace {
+using Bytes32 = std::array<uint8_t, 32>;
+
+// ---------------------------------------------------------------- SHA-256 (for the merge tree)
+struct Sha256 {
+    uint32_t h[8];
+    uint8_t buf[64];
+    uint64_t len{0};
+    size_t n{0};
+    static constexpr uint32_t K[64] = {
+        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
+        0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
+        0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
+        0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2};
+    Sha256() { const uint32_t init[8] = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19}; std::copy(init, init + 8, h); }
+    static uint32_t R(uint32_t x, int r) { return (x >> r) | (x << (32 - r)); }
+    void Block(const uint8_t* p)
+    {
+        uint32_t w[64];
+        for (int i = 0; i < 16; ++i) w[i] = uint32_t(p[4 * i]) << 24 | uint32_t(p[4 * i + 1]) << 16 | uint32_t(p[4 * i + 2]) << 8 | p[4 * i + 3];
+        for (int i = 16; i < 64; ++i) w[i] = w[i - 16] + (R(w[i - 15], 7) ^ R(w[i - 15], 18) ^ (w[i - 15] >> 3)) + w[i - 7] + (R(w[i - 2], 17) ^ R(w[i - 2], 19) ^ (w[i - 2] >> 10));
+        uint32_t a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], hh = h[7];
+        for (int i = 0; i < 64; ++i) {
+            uint32_t t1 = hh + (R(e, 6) ^ R(e, 11) ^ R(e, 25)) + ((e & f) ^ (~e & g)) + K[i] + w[i];
+            uint32_t t2 = (R(a, 2) ^ R(a, 13) ^ R(a, 22)) + ((a & b) ^ (a & c) ^ (b & c));
+            hh = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
+        }
+        h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
+    }
+    void Write(const uint8_t* p, size_t l)
+    {
+        len += l;
+        while (l) {
+            size_t k = std::min(l, 64 - n);
+            std::memcpy(buf + n, p, k); n += k; p += k; l -= k;
+            if (n == 64) { Block(buf); n = 0; }
+        }
+    }
+    Bytes32 Final()
+    {
+        uint64_t bits = len * 8;
+        uint8_t pad = 0x80;
+        Write(&pad, 1);
+        uint8_t z = 0;
+        while (n != 56) Write(&z, 1);
+        uint8_t lb[8];
+        for (int i = 0; i < 8; ++i) lb[i] = uint8_t(bits >> (56 - 8 * i));
+        Write(lb, 8);
+        Bytes32 out;
+        for (int i = 0; i < 8; ++i) for (int j = 0; j < 4; ++j) out[4 * i + j] = uint8_t(h[i] >> (24 - 8 * j));
+        return out;
+    }
+};
+Bytes32 Sha256d(const uint8_t* p, size_t l)
+{
+    Sha256 a; a.Write(p, l); Bytes32 x = a.Final();
+    Sha256 b; b.Write(x.data(), 32); return b.Final();
+}
+Bytes32 Node(const Bytes32& l, const Bytes32& r)
+{
+    uint8_t b[64]; std::memcpy(b, l.data(), 32); std::memcpy(b + 32, r.data(), 32); return Sha256d(b, 64);
+}
+
+// ---------------------------------------------------------------- hex / base64
+std::vector<uint8_t> FromHex(const std::string& s)
+{
+    std::vector<uint8_t> o;
+    for (size_t i = 0; i + 1 < s.size(); i += 2) o.push_back(uint8_t(std::stoi(s.substr(i, 2), nullptr, 16)));
+    return o;
+}
+std::string ToHex(const uint8_t* p, size_t l)
+{
+    static const char* d = "0123456789abcdef";
+    std::string s;
+    for (size_t i = 0; i < l; ++i) { s += d[p[i] >> 4]; s += d[p[i] & 15]; }
+    return s;
+}
+// uint256 display hex (reversed) <-> internal bytes
+Bytes32 FromDisplayHex(const std::string& s) { auto v = FromHex(s); Bytes32 b{}; for (size_t i = 0; i < 32 && i < v.size(); ++i) b[i] = v[31 - i]; return b; }
+std::string ToDisplayHex(const Bytes32& b) { Bytes32 r; for (int i = 0; i < 32; ++i) r[i] = b[31 - i]; return ToHex(r.data(), 32); }
+std::string Base64(const std::string& in)
+{
+    static const char* t = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    std::string o; int val = 0, bits = -6;
+    for (unsigned char c : in) { val = (val << 8) + c; bits += 8; while (bits >= 0) { o += t[(val >> bits) & 63]; bits -= 6; } }
+    if (bits > -6) o += t[((val << 8) >> (bits + 8)) & 63];
+    while (o.size() % 4) o += '=';
+    return o;
+}
+
+// ---------------------------------------------------------------- JSON-RPC over HTTP
+struct Node_t {
+    std::string coin, address, host, auth;
+    int port;
+    int slot;
+};
+
+std::optional<UniValue> Rpc(const Node_t& node, const std::string& method, const UniValue& params, std::string& error)
+{
+    UniValue req(UniValue::VOBJ);
+    req.pushKV("jsonrpc", "1.0"); req.pushKV("id", "cs-miner"); req.pushKV("method", method); req.pushKV("params", params);
+    const std::string body = req.write();
+    std::ostringstream http;
+    http << "POST / HTTP/1.1\r\nHost: " << node.host << "\r\nAuthorization: Basic " << Base64(node.auth)
+         << "\r\nContent-Type: application/json\r\nConnection: close\r\nContent-Length: " << body.size() << "\r\n\r\n" << body;
+    const std::string out = http.str();
+
+    addrinfo hints{}, *res = nullptr;
+    hints.ai_family = AF_UNSPEC; hints.ai_socktype = SOCK_STREAM;
+    if (getaddrinfo(node.host.c_str(), std::to_string(node.port).c_str(), &hints, &res) != 0 || !res) { error = "cannot resolve host"; return std::nullopt; }
+    socket_t s = socket(res->ai_family, res->ai_socktype, res->ai_protocol);
+    if (connect(s, res->ai_addr, (int)res->ai_addrlen) != 0) { freeaddrinfo(res); CloseSocket(s); error = "node not reachable on port " + std::to_string(node.port); return std::nullopt; }
+    freeaddrinfo(res);
+    send(s, out.data(), (int)out.size(), 0);
+    std::string resp; char b[4096]; int r;
+    while ((r = recv(s, b, sizeof(b), 0)) > 0) resp.append(b, r);
+    CloseSocket(s);
+    const auto p = resp.find("\r\n\r\n");
+    if (p == std::string::npos) { error = "bad HTTP response"; return std::nullopt; }
+    if (resp.compare(0, 12, "HTTP/1.1 401") == 0) { error = "authentication failed (check the .cookie file / datadir)"; return std::nullopt; }
+    UniValue v;
+    if (!v.read(resp.substr(p + 4))) { error = "bad JSON response"; return std::nullopt; }
+    if (!v["error"].isNull()) { error = v["error"].write(); return std::nullopt; }
+    return v["result"];
+}
+
+std::string ReadCookie(const std::string& datadir, const std::string& coin, const std::string& chain)
+{
+    const std::string sub = coin + (chain == "main" ? "" : chain == "test" ? "-testnet" : "-regtest");
+    std::ifstream f(datadir + "/" + sub + "/.cookie");
+    std::string c;
+    std::getline(f, c);
+    return c;
+}
+
+std::string DefaultDatadir()
+{
+#ifdef _WIN32
+    const char* a = std::getenv("LOCALAPPDATA");
+    return a ? std::string(a) + "\\Bitcoin" : ".";
+#else
+    const char* h = std::getenv("HOME");
+    return h ? std::string(h) + "/.bitcoin" : ".";
+#endif
+}
+
+// ---------------------------------------------------------------- RandomX
+struct Rx {
+    randomx_cache* cache{nullptr};
+    randomx_dataset* dataset{nullptr};
+    randomx_flags flags{RANDOMX_FLAG_DEFAULT};
+    std::string key;
+    int version{0};
+    bool fast{true};
+    void Release()
+    {
+        if (dataset) randomx_release_dataset(dataset);
+        if (cache) randomx_release_cache(cache);
+        dataset = nullptr; cache = nullptr; key.clear();
+    }
+    void SetKey(const std::vector<uint8_t>& k, int v, unsigned threads)
+    {
+        const std::string ks(k.begin(), k.end());
+        if (ks == key && v == version) return;
+        Release();
+        flags = randomx_get_flags();
+        if (v == 2) flags = flags | RANDOMX_FLAG_V2;
+        cache = randomx_alloc_cache(flags);
+        if (!cache) { flags = RANDOMX_FLAG_DEFAULT; if (v == 2) flags = flags | RANDOMX_FLAG_V2; cache = randomx_alloc_cache(flags); }
+        randomx_init_cache(cache, k.data(), k.size());
+        if (fast) {
+            dataset = randomx_alloc_dataset(flags);
+            if (!dataset) { std::cerr << "Not enough memory for fast mode (about 2.1 GB); using light mode\n"; fast = false; }
+            else {
+                const unsigned long items = randomx_dataset_item_count();
+                std::vector<std::thread> ts;
+                for (unsigned i = 0; i < threads; ++i) {
+                    const unsigned long start = items * i / threads, end = items * (i + 1) / threads;
+                    ts.emplace_back([=, this] { randomx_init_dataset(dataset, cache, start, end - start); });
+                }
+                for (auto& t : ts) t.join();
+            }
+        }
+        key = ks; version = v;
+    }
+    randomx_vm* NewVm() const
+    {
+        return fast ? randomx_create_vm(flags | RANDOMX_FLAG_FULL_MEM, nullptr, dataset) : randomx_create_vm(flags, cache, nullptr);
+    }
+};
+
+// little-endian hash <= big-endian target
+bool MeetsTarget(const uint8_t* hash_le, const std::vector<uint8_t>& target_be)
+{
+    for (int i = 0; i < 32; ++i) {
+        const uint8_t h = hash_le[31 - i], t = target_be[i];
+        if (h != t) return h < t;
+    }
+    return true;
+}
+
+void Usage()
+{
+    std::cout << "cs-miner: Coin Series merged miner\n\n"
+                 "  --coin NAME=ADDRESS   chain to mine and its reward address (repeat for each chain)\n"
+                 "  --chain main|test|regtest   (default main)\n"
+                 "  --datadir DIR         node data directory (default: the node's default)\n"
+                 "  --host HOST           node host (default 127.0.0.1)\n"
+                 "  --threads N           mining threads (default: half of the CPU threads, to limit laptop heat)\n"
+                 "  --light               light mode (256 MB instead of 2.1 GB, much slower)\n"
+                 "  --refresh SECONDS     fetch fresh work at least this often (default 30)\n"
+                 "  --blocks N            stop after every chain found N blocks (default: run forever)\n";
+}
+} // namespace
+
+int main(int argc, char** argv)
+{
+#ifdef _WIN32
+    WSADATA wsa;
+    WSAStartup(MAKEWORD(2, 2), &wsa);
+#endif
+    const std::map<std::string, std::pair<int, int>> COINS{{"half", {0, 21202}}, {"quarter", {1, 21204}}, {"dime", {2, 21210}}, {"nickel", {3, 21220}}, {"cent", {4, 21300}}};
+    std::string chain = "main", datadir = DefaultDatadir(), host = "127.0.0.1";
+    unsigned threads = std::max(1u, std::thread::hardware_concurrency() / 2);
+    bool light = false;
+    int refresh = 30, blocks = 0;
+    std::vector<std::pair<std::string, std::string>> coins;
+    for (int i = 1; i < argc; ++i) {
+        const std::string a = argv[i];
+        auto next = [&]() -> std::string { if (i + 1 >= argc) { Usage(); std::exit(1); } return argv[++i]; };
+        if (a == "--coin") { const std::string v = next(); const auto e = v.find('='); if (e == std::string::npos) { Usage(); return 1; } coins.emplace_back(v.substr(0, e), v.substr(e + 1)); }
+        else if (a == "--chain") chain = next();
+        else if (a == "--datadir") datadir = next();
+        else if (a == "--host") host = next();
+        else if (a == "--threads") threads = std::max(1, std::stoi(next()));
+        else if (a == "--light") light = true;
+        else if (a == "--refresh") refresh = std::stoi(next());
+        else if (a == "--blocks") blocks = std::stoi(next());
+        else { Usage(); return a == "--help" || a == "-h" ? 0 : 1; }
+    }
+    if (coins.empty()) { Usage(); return 1; }
+    const int env_offset = chain == "main" ? 0 : chain == "test" ? 1000 : 2000;
+    std::vector<Node_t> nodes;
+    for (const auto& [name, addr] : coins) {
+        auto it = COINS.find(name);
+        if (it == COINS.end()) { std::cerr << "unknown coin " << name << "\n"; return 1; }
+        const std::string cookie = ReadCookie(datadir, name, chain);
+        if (cookie.empty()) { std::cerr << "cannot read the .cookie file of the " << name << " node in " << datadir << " (is the node running?)\n"; return 1; }
+        nodes.push_back({name, addr, host, cookie, it->second.second + env_offset, it->second.first});
+    }
+    std::cout << "cs-miner: " << nodes.size() << " chain(s), " << threads << " thread(s), " << (light ? "light" : "fast") << " mode\n";
+
+    Rx rx;
+    rx.fast = !light;
+    std::map<std::string, int> found;
+    for (const auto& n : nodes) found[n.coin] = 0;
+    uint64_t total_hashes = 0;
+    double mining_seconds = 0; // excludes RandomX key setup (dataset initialisation)
+
+    while (true) {
+        if (blocks > 0 && std::all_of(found.begin(), found.end(), [&](const auto& kv) { return kv.second >= blocks; })) break;
+        // Fetch work with one common header time.
+        const int64_t now = std::chrono::duration_cast<std::chrono::seconds>(std::chrono::system_clock::now().time_since_epoch()).count();
+        struct Work { const Node_t* node; std::string commitment; int slot; std::vector<uint8_t> target; int64_t height; std::string key; int version; };
+        std::vector<Work> work;
+        for (const auto& n : nodes) {
+            std::string err;
+            UniValue p(UniValue::VARR); p.push_back(n.address); p.push_back(now);
+            auto r = Rpc(n, "getmergework", p, err);
+            if (!r) { UniValue p2(UniValue::VARR); p2.push_back(n.address); r = Rpc(n, "getmergework", p2, err); }
+            if (!r) { std::cerr << n.coin << ": " << err << "\n"; continue; }
+            work.push_back({&n, (*r)["commitment"].get_str(), (*r)["slot"].getInt<int>(), FromHex((*r)["target"].get_str()), (*r)["height"].getInt<int64_t>(),
+                            (*r)["randomxkey"].get_str(), (*r)["randomxversion"].getInt<int>()});
+        }
+        if (work.empty()) { std::this_thread::sleep_for(std::chrono::seconds(5)); continue; }
+        // Mine together only chains that share the first chain's RandomX key and version.
+        const std::string key = work[0].key; const int version = work[0].version;
+        work.erase(std::remove_if(work.begin(), work.end(), [&](const Work& w) { return w.key != key || w.version != version; }), work.end());
+        rx.SetKey(FromHex(key), version, threads);
+
+        std::array<Bytes32, 8> leaves{};
+        for (const auto& w : work) leaves[w.slot] = FromDisplayHex(w.commitment);
+        std::array<Bytes32, 4> l1; for (int i = 0; i < 4; ++i) l1[i] = Node(leaves[2 * i], leaves[2 * i + 1]);
+        std::array<Bytes32, 2> l2{Node(l1[0], l1[1]), Node(l1[2], l1[3])};
+        const Bytes32 root = Node(l2[0], l2[1]);
+
+        std::atomic<bool> stop{false};
+        std::atomic<uint64_t> hashes{0};
+        std::mutex mu;
+        std::vector<std::pair<size_t, uint64_t>> solutions; // (work index, nonce)
+        std::vector<bool> solved(work.size(), false);
+        const uint64_t base = (uint64_t(std::random_device{}()) << 32) ^ uint64_t(now);
+        std::vector<std::thread> ts;
+        for (unsigned t = 0; t < threads; ++t) {
+            ts.emplace_back([&, t] {
+                randomx_vm* vm = rx.NewVm();
+                if (!vm) { stop = true; return; }
+                uint8_t input[40], out[32];
+                std::memcpy(input, root.data(), 32);
+                for (uint64_t nonce = base + t; !stop; nonce += threads) {
+                    for (int i = 0; i < 8; ++i) input[32 + i] = uint8_t(nonce >> (8 * i));
+                    randomx_calculate_hash(vm, input, 40, out);
+                    ++hashes;
+                    for (size_t w = 0; w < work.size(); ++w) {
+                        if (MeetsTarget(out, work[w].target)) {
+                            std::lock_guard<std::mutex> l(mu);
+                            if (!solved[w]) { solved[w] = true; solutions.emplace_back(w, nonce); }
+                        }
+                    }
+                    if (std::all_of(solved.begin(), solved.end(), [](bool b) { return b; })) stop = true;
+                }
+                randomx_destroy_vm(vm);
+            });
+        }
+        const auto round_start = std::chrono::steady_clock::now();
+        const auto deadline = round_start + std::chrono::seconds(refresh);
+        while (!stop && std::chrono::steady_clock::now() < deadline) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(200));
+            std::lock_guard<std::mutex> l(mu);
+            if (!solutions.empty()) stop = true; // submit as soon as any chain is solved, then refresh work
+        }
+        stop = true;
+        for (auto& t : ts) t.join();
+        total_hashes += hashes;
+        mining_seconds += std::chrono::duration<double>(std::chrono::steady_clock::now() - round_start).count();
+
+        for (const auto& [w, nonce] : solutions) {
+            const auto& wk = work[w];
+            const int s = wk.slot;
+            UniValue branch(UniValue::VARR);
+            branch.push_back(ToDisplayHex(leaves[s ^ 1]));
+            branch.push_back(ToDisplayHex(l1[(s >> 1) ^ 1]));
+            branch.push_back(ToDisplayHex(l2[(s >> 2) ^ 1]));
+            UniValue p(UniValue::VARR); p.push_back(wk.commitment); p.push_back(branch); p.push_back(std::to_string(nonce));
+            std::string err;
+            auto r = Rpc(*wk.node, "submitmergework", p, err);
+            const bool ok = r && (*r)["accepted"].isTrue();
+            if (ok) ++found[wk.node->coin];
+            std::cout << wk.node->coin << " height " << wk.height << " nonce " << nonce << (ok ? " accepted" : " rejected " + (r ? (*r)["reason"].write() : err)) << std::endl;
+        }
+        std::cout << "  " << std::fixed << std::setprecision(1) << (total_hashes / std::max(mining_seconds, 1e-9)) << " H/s average (" << threads << " thread(s))" << std::endl;
+    }
+    std::cout << "done:";
+    for (const auto& [c, n] : found) std::cout << " " << c << "=" << n;
+    std::cout << std::endl;
+    rx.Release();
+    return 0;
+}
