+#!/usr/bin/env bash
+# cs-miner smoke test (regtest): five nodes, the C++ merged miner mines all five chains together.
+# Usage: contrib/coinseries/miner_smoke.sh <build/bin> [extra cs-miner args]
+set -uo pipefail
+BIN=${1:-build/bin}; shift || true
+WORK=$(mktemp -d)
+COINS="half quarter dime nickel cent"
+cleanup() { for c in $COINS; do "$BIN/bitcoin-cli" -datadir="$WORK" -coin=$c -regtest stop >/dev/null 2>&1; done; sleep 3; rm -rf "$WORK"; }
+trap cleanup EXIT
+for c in $COINS; do "$BIN/bitcoind" -datadir="$WORK" -coin=$c -regtest -daemon -listen=0 >/dev/null; done
+sleep 3
+ARGS=()
+for c in $COINS; do
+  "$BIN/bitcoin-cli" -datadir="$WORK" -coin=$c -regtest -rpcwait createwallet w >/dev/null
+  ARGS+=(--coin "$c=$("$BIN/bitcoin-cli" -datadir="$WORK" -coin=$c -regtest getnewaddress)")
+done
+"$BIN/cs-miner" --chain regtest --datadir "$WORK" --blocks 10 --refresh 5 "${ARGS[@]}" "$@" | tail -4
+FAIL=0
+for c in $COINS; do
+  H=$("$BIN/bitcoin-cli" -datadir="$WORK" -coin=$c -regtest getblockcount)
+  echo "$c height $H"; [[ $H -ge 10 ]] || FAIL=1
+done
+[[ $FAIL == 0 ]] && echo "PASS  cs-miner mined all five chains" || echo "FAIL  cs-miner"
+exit $FAIL
